<?xml version="1.0" encoding="utf-8"?>
<!--
  Detalle de un día (copy/DayCopy.kt): se abre al tocar el marcador o una barra del calendario.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). Los arrays con sufijo (_one, _notime, _noeq) son la
  misma situación en otro caso gramatical: mantén el mismo sentido en cada posición.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="pt">

    <!-- Título en frase. %1$s es la fecha larga («martes 3 de noviembre»). -->
    <string name="day_title_today">Hoje, %1$s</string>
    <string name="day_title_yesterday">Ontem, %1$s</string>

    <!-- Etiqueta en MAYÚSCULAS (se pasa a mayúsculas sola): «MARTES 3 NOV». %1$s día de la semana,
         %2$s fecha corta («3 nov» o «3 nov 2025»). -->
    <string name="day_label_date">%1$s %2$s</string>
    <!-- «HOY · MARTES 3 NOV»: %1$s es la etiqueta de arriba, ya en mayúsculas. -->
    <string name="day_label_today">HOJE · %1$s</string>
    <string name="day_label_yesterday">ONTEM · %1$s</string>

    <!-- Frase de un día pasado, cero vídeos. -->
    <string-array name="day_zero">
        <item>Nesse dia, nem um vídeo.</item>
        <item>Zero. Um dia de ouro, ou um dia sem sinal.</item>
        <item>Nada nesse dia. Ou você não viu nada, ou eu não estava olhando.</item>
    </string-array>

    <!-- Con objetivo, pasado: %1$s lo que se pasó («62 vídeos»), %2$s el objetivo, %3$s los vídeos del día. -->
    <string-array name="day_goal_over">
        <item>Nesse dia você passou em %1$s.</item>
        <item>Meta: %2$s. Nesse dia: %3$s.</item>
        <item>%1$s acima da meta. Acontece.</item>
    </string-array>
    <!-- Con objetivo, justo en el límite: %1$s el objetivo. -->
    <string-array name="day_goal_at">
        <item>No limite: %1$s, nem um a mais.</item>
        <item>%1$s de %1$s. Cravado.</item>
        <item>Meta cravada nesse dia.</item>
    </string-array>
    <!-- Con objetivo, por debajo: %1$s los vídeos del día, %2$s el objetivo, %3$s el margen («38 vídeos»). -->
    <string-array name="day_goal_under">
        <item>Dentro da meta: %1$s de %2$s.</item>
        <item>Abaixo de %2$s, com %3$s de margem.</item>
        <item>%1$s de %2$s. Dia dentro do limite.</item>
    </string-array>

    <!-- Día flojo (1–9 vídeos): %1$s los vídeos («3 vídeos»), %2$s el tiempo («2 minutos»).
         _one: un solo vídeo. _notime: menos de un minuto (sin tiempo en la frase). -->
    <string-array name="day_first">
        <item>Nesse dia foram %1$s. Quase nada.</item>
        <item>%1$s e %2$s. Um dia tranquilo.</item>
        <item>Pouca coisa: %1$s.</item>
    </string-array>
    <string-array name="day_first_notime">
        <item>Nesse dia foram %1$s. Quase nada.</item>
        <item>%1$s. Um dia tranquilo.</item>
        <item>Pouca coisa: %1$s.</item>
    </string-array>
    <string-array name="day_first_one">
        <item>Nesse dia foi %1$s. Quase nada.</item>
        <item>%1$s e %2$s. Um dia tranquilo.</item>
        <item>Pouca coisa: %1$s.</item>
    </string-array>
    <string-array name="day_first_one_notime">
        <item>Nesse dia foi %1$s. Quase nada.</item>
        <item>%1$s. Um dia tranquilo.</item>
        <item>Pouca coisa: %1$s.</item>
    </string-array>

    <!-- Día normal: %1$s los vídeos, %2$s el tiempo («47 minutos»), %3$s el tiempo con mayúscula
         inicial (para empezar la frase con él). -->
    <string-array name="day_normal">
        <item>%1$s e %2$s. Um dia normal, o que já é dizer muito.</item>
        <item>Nesse dia: %2$s de vídeo.</item>
        <item>%3$s. Nem bem, nem mal.</item>
    </string-array>

    <!-- Día alto: %1$s los vídeos, %2$s el tiempo con mayúscula inicial, %3$s el tiempo, %4$s una
         equivalencia en infinitivo («leer 14 libros»). _noeq: sin equivalencia (no uses %4$s).
         _one: el tiempo es singular («una hora y 40 minutos»). -->
    <string-array name="day_high">
        <item>%1$s. Nesse dia o algoritmo fez hora extra.</item>
        <item>%2$s de vídeo. Dava pra %4$s.</item>
        <item>Nesse dia se foram %3$s. Assim, sem mais.</item>
    </string-array>
    <string-array name="day_high_noeq">
        <item>%1$s. Nesse dia o algoritmo fez hora extra.</item>
        <item>%2$s de vídeo. Um dia longo.</item>
        <item>Nesse dia se foram %3$s. Assim, sem mais.</item>
    </string-array>
    <string-array name="day_high_one">
        <item>%1$s. Nesse dia o algoritmo fez hora extra.</item>
        <item>%2$s de vídeo. Dava pra %4$s.</item>
        <item>Nesse dia se foi %3$s. Assim, sem mais.</item>
    </string-array>
    <string-array name="day_high_one_noeq">
        <item>%1$s. Nesse dia o algoritmo fez hora extra.</item>
        <item>%2$s de vídeo. Um dia longo.</item>
        <item>Nesse dia se foi %3$s. Assim, sem mais.</item>
    </string-array>

    <!-- Día extremo: %1$s los vídeos, %2$s el tiempo con mayúscula inicial. -->
    <string-array name="day_extreme">
        <item>%1$s. Tem dia e dia, e esse foi dos grandes.</item>
        <item>%2$s. Se alguém perguntar, você tinha o que fazer.</item>
        <item>%1$s num dia só. Dessa vez quem ganhou foi o algoritmo.</item>
    </string-array>

    <!-- Puesto del día entre todos los contados (MAYÚSCULAS). -->
    <string name="day_rank_record">SEU RECORDE: O DIA COM MAIS VÍDEOS</string>
    <!-- %1$s el puesto, %2$s los días contados (siempre 2 o más). -->
    <plurals name="day_rank_line">
        <item quantity="one">N.º %1$s DE %2$s DIA CONTADO</item>
        <item quantity="many">N.º %1$s DE %2$s DIAS CONTADOS</item>
        <item quantity="other">N.º %1$s DE %2$s DIAS CONTADOS</item>
    </plurals>

    <!-- Estado frente al objetivo de un día cerrado (MAYÚSCULAS, columna estrecha: corto). %1$s cifra. -->
    <string name="day_goal_status_over">+%1$s\u00A0ACIMA</string>
    <string name="day_goal_status_at">NO LIMITE</string>
    <string name="day_goal_status_under">%1$s\u00A0ABAIXO</string>

    <!-- Lo mismo para TalkBack: %1$s la diferencia («38 vídeos»), %2$s el objetivo. -->
    <string name="day_goal_status_over_description">%1$s acima da meta de %2$s</string>
    <!-- %1$s el objetivo. -->
    <string name="day_goal_status_at_description">Exatamente na meta de %1$s</string>
    <string name="day_goal_status_under_description">%1$s abaixo da meta de %2$s</string>

    <!-- Cabecera de la sección por horas de un día pasado (MAYÚSCULAS). -->
    <string name="day_section_hours">NESSE DIA, HORA A HORA</string>
    <!-- «PRIMER VÍDEO 08:12 · ÚLTIMO 01:47»: %1$s hora del primero, %2$s del último. -->
    <string name="day_first_last">PRIMEIRO VÍDEO %1$s · ÚLTIMO %2$s</string>
</resources>
