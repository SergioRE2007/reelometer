<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo Pasaporte (copy/PassportCopy.kt): pestaña con Flap (la mascota), la tarjeta de embarque
  (niveles y millas), los sellos, el reto semanal contra «tu fantasma» (tú la semana pasada), las
  celebraciones y el ticket de nivel que se comparte como imagen.
  Tono: aeropuerto, tarjeta de embarque, ironía amable. Premia ver menos y nunca culpa.
  Las millas salen de ver MENOS vídeos (días bajo la referencia, rachas, retos y sellos), nunca de verlos.
  Nombres propios: «Flap» (la mascota) y «Reelometer» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
  (Traducción pt-BR: «você» con verbo en tercera persona, como se habla en Brasil.)
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="pt-BR">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña y nombre del modo (palabra normal: tradúcela). -->
    <string name="passport_title">Passaporte</string>

    <!-- Cabeceras de sección, en MAYÚSCULAS. «FLAP» es el nombre de la mascota (no se traduce). -->
    <string name="passport_section_flap">FLAP</string>
    <string name="passport_section_level">CARTÃO DE EMBARQUE</string>
    <string name="passport_section_challenge">DESAFIO DA SEMANA</string>
    <string name="passport_section_stamps">CARIMBOS</string>
    <string name="passport_section_past">DESAFIOS ANTERIORES</string>

    <!-- Kicker de la cabecera: «63 DÍAS A BORDO». %1$s son los días («63 días»). Se pasa a mayúsculas sola. -->
    <string name="passport_on_board">%1$s a bordo</string>

    <!-- ============================================================ Flap (la mascota) -->

    <!-- Estado de Flap, en MAYÚSCULAS y corto (etiqueta junto al dibujo). En TalkBack se lee en minúsculas. -->
    <string name="passport_mood_fit">EM FORMA</string>
    <string name="passport_mood_normal">NORMAL</string>
    <string name="passport_mood_tired">CANSADO</string>
    <string name="passport_mood_zombie">ZUMBI DO SCROLL</string>
    <!-- Estado mientras Flap no tiene con qué comparar (ni objetivo ni historial). MAYÚSCULAS. -->
    <string name="passport_warming_up">AQUECENDO</string>

    <!-- Frase de Flap en forma (la semana va bien). -->
    <string-array name="passport_phrase_fit">
        <item>Flap está de boa esta semana.</item>
        <item>Flap está em plena forma. Você também, mesmo que não pareça.</item>
        <item>Flap nem lembra mais o que era scroll.</item>
        <item>Flap voltou a olhar pela janelinha.</item>
        <item>Flap se inscreveu para correr. Por enquanto, está indo bem.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="passport_phrase_normal">
        <item>Flap vai levando.</item>
        <item>Flap, nem fede nem cheira.</item>
        <item>Flap segura a onda.</item>
        <item>Flap está igualzinho à sua semana: normal.</item>
        <item>Flap, nem bem, nem mal. Flap, só isso.</item>
    </string-array>
    <!-- Frase de Flap cansado (la semana va regular). -->
    <string-array name="passport_phrase_tired">
        <item>Flap está com olheiras.</item>
        <item>Flap dormiu pouco e dá para notar.</item>
        <item>Flap pede uma pausa. Um dia tranquilo resolve.</item>
        <item>Flap boceja entre um vídeo e outro.</item>
        <item>Flap está cansado, mas não desiste.</item>
    </string-array>
    <!-- Frase de Flap zombi (mucho scroll). Sin culpa: siempre se puede recuperar. -->
    <string-array name="passport_phrase_zombie">
        <item>Flap anda com os braços esticados para a frente.</item>
        <item>Flap só consegue dizer “mais um”.</item>
        <item>Flap é um zumbi do scroll. Um dia tranquilo cura.</item>
        <item>Flap não morreu. Só está passando por uma fase ruim.</item>
        <item>Flap se recupera assim que você tiver um dia tranquilo.</item>
    </string-array>
    <!-- Frase mientras Flap calienta (sin objetivo ni historial suficiente). -->
    <string-array name="passport_phrase_warming">
        <item>Flap ainda está conhecendo você. Dê uns dias para ele.</item>
        <item>Sem meta nem histórico, Flap não julga. Ainda não.</item>
        <item>Flap está se alongando. Em alguns dias ele diz alguma coisa.</item>
        <item>Primeiros dias: Flap observa e anota.</item>
    </string-array>
    <!-- Frase cuando Flap vuelve de zombi a normal o mejor. -->
    <string-array name="passport_phrase_recovered">
        <item>Flap voltou do mundo dos scrolls.</item>
        <item>Nem zumbi nem nada: Flap se recuperou.</item>
        <item>Flap voltou a piscar normalmente.</item>
        <item>Flap voltou. Diz que não lembra de nada.</item>
    </string-array>

