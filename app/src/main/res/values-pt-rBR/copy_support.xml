<?xml version="1.0" encoding="utf-8"?>
<!--
  Aviso de apoyo (copy/SupportCopy.kt): un único aviso grande y centrado que sale como mucho dos
  veces y lleva al GitHub del proyecto. Sin prometer nada que la app no haga: no tiene internet; el
  enlace lo abre el navegador. «GitHub» no se traduce.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="pt-BR">

    <!-- Antetítulo en MAYÚSCULAS, muy corto. -->
    <string name="support_kicker">UMA COISA</string>
    <string name="support_title">Este app é feito por um estudante.</string>
    <string name="support_text">O Reelometer é gratuito, não tem anúncios e seus dados não saem do celular. É feito por um estudante nas horas vagas. No GitHub do projeto você pode ver como ele foi feito e, se quiser, apoiá-lo.</string>
    <!-- Pie pequeño bajo el texto: qué pasa al pulsar. -->
    <string name="support_note">Abre no navegador. O app continua sem internet.</string>
    <!-- Botón principal en MAYÚSCULAS. -->
    <string name="support_open">VER O GITHUB DO PROJETO</string>
    <!-- Enlace pequeño para no volver a ver el aviso. -->
    <string name="support_never">Não mostrar de novo</string>
    <!-- Si no se pudo abrir el navegador. %1$s la dirección del proyecto sin «https://github.com/» («usuario/proyecto»). -->
    <string name="support_open_failed">Não foi possível abrir o navegador. Procure no GitHub: %1$s.</string>

    <!-- TalkBack: título del aviso y de los botones. -->
    <string name="support_pane_title">Apoiar o Reelometer</string>
    <string name="support_open_description">Ver o GitHub do projeto. Abre no navegador</string>
    <string name="support_never_description">Não mostrar este aviso de novo</string>

    <!--
      Versión de Google Play: el mismo aviso, NEUTRO. La política de pagos de Play no admite pedir apoyo,
      donaciones ni pagos fuera de Play: aquí nada de «apoyar», «donar», «café» ni parecidos; solo ofrecer
      ver el código. Antetítulo, título, nota, error y «No volver a mostrar» son los de arriba.
    -->
    <string name="support_text_play">O Reelometer é gratuito, não tem anúncios e seus dados não saem do celular. É feito por um estudante nas horas vagas. Quer ver como ele foi feito? O código está no GitHub.</string>
    <!-- Botón principal en MAYÚSCULAS. -->
    <string name="support_open_play">VER O CÓDIGO</string>
    <!-- TalkBack: título del aviso y del botón principal. -->
    <string name="support_pane_title_play">Sobre o Reelometer</string>
    <string name="support_open_description_play">Ver o código no GitHub. Abre no navegador</string>
</resources>
