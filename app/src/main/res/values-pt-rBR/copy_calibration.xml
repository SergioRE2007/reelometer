    <!-- Memoria del proceso al morir, detrás de la línea del cierre: %1$s = la línea, %2$s = PSS en MB, %3$s = RSS en MB (RSS no se traduce). -->
    <string name="calibration_exit_memory">%1$s · memória %2$s\u00A0MB (RSS %3$s\u00A0MB)</string>

    <!-- Cabecera del registro: estado del sistema. Lo que Android dice de la app y lo que el servicio apunta de su vida, para saber por qué deja de contar tras un rato sin usar el móvil. Formato «clave: valor». En conexiones y desconexiones, %1$s es la fecha y la hora. «standby bucket» es el nombre de Android. -->
    <string name="calibration_system_title">Estado do sistema (o que o Android diz sobre o app):</string>
    <string name="calibration_system_battery">Bateria sem restrições: %1$s · uso em segundo plano restrito: %2$s · economia de bateria ativada: %3$s</string>
    <string name="calibration_system_bucket">Grupo de uso (standby bucket): %1$s</string>
    <string name="calibration_system_hibernation">Isento de “Pausar atividade do app se não usado”: %1$s</string>
    <string name="calibration_system_process">Processo iniciado há %1$s · notificações permitidas: %2$s</string>
    <string name="calibration_system_connections">Conexões do serviço (a mais recente primeiro): %1$s</string>
