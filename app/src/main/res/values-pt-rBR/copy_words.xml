<?xml version="1.0" encoding="utf-8"?>
<!--
  Palabras compartidas por toda la app (copy/Words.kt): recuentos con plural, duraciones con
  palabras, listas, horas y periodos. %1$s es siempre la cifra ya formateada («1.234»).
  \u00A0 es un espacio duro: la cifra y su palabra no se separan al partir la línea.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="pt">

    <!-- Recuentos: «1 vídeo», «212 vídeos». -->
    <plurals name="words_videos">
        <item quantity="one">%1$s\u00A0vídeo</item>
        <item quantity="many">%1$s\u00A0vídeos</item>
        <item quantity="other">%1$s\u00A0vídeos</item>
    </plurals>
    <plurals name="words_times">
        <item quantity="one">%1$s\u00A0vez</item>
        <item quantity="many">%1$s\u00A0vezes</item>
        <item quantity="other">%1$s\u00A0vezes</item>
    </plurals>
    <plurals name="words_days">
        <item quantity="one">%1$s\u00A0dia</item>
        <item quantity="many">%1$s\u00A0dias</item>
        <item quantity="other">%1$s\u00A0dias</item>
    </plurals>
    <plurals name="words_hours">
        <item quantity="one">%1$s\u00A0hora</item>
        <item quantity="many">%1$s\u00A0horas</item>
        <item quantity="other">%1$s\u00A0horas</item>
    </plurals>
    <plurals name="words_minutes">
        <item quantity="one">%1$s\u00A0minuto</item>
        <item quantity="many">%1$s\u00A0minutos</item>
        <item quantity="other">%1$s\u00A0minutos</item>
    </plurals>
    <plurals name="words_seconds">
        <item quantity="one">%1$s\u00A0segundo</item>
        <item quantity="many">%1$s\u00A0segundos</item>
        <item quantity="other">%1$s\u00A0segundos</item>
    </plurals>

    <!-- Duraciones dentro de una frase: «un segundo», «45 segundos», «un minuto», «47 minutos»,
         «una hora», «3 horas». En español el 1 va en letra; en idiomas donde «one» abarca más
         números (ruso: 21, 31…), escribe la cifra con %1$s. -->
    <plurals name="words_duration_seconds">
        <item quantity="one">%1$s\u00A0segundo</item>
        <item quantity="many">%1$s\u00A0segundos</item>
        <item quantity="other">%1$s\u00A0segundos</item>
    </plurals>
    <plurals name="words_duration_minutes">
        <item quantity="one">%1$s\u00A0minuto</item>
        <item quantity="many">%1$s\u00A0minutos</item>
        <item quantity="other">%1$s\u00A0minutos</item>
    </plurals>
    <plurals name="words_duration_hours">
        <item quantity="one">%1$s\u00A0hora</item>
        <item quantity="many">%1$s\u00A0horas</item>
        <item quantity="other">%1$s\u00A0horas</item>
    </plurals>
    <!-- «una hora y 12 minutos»: %1$s las horas, %2$s los minutos (ya con sus palabras). -->
    <string name="words_duration_hours_minutes">%1$s e %2$s</string>

    <!-- Listas: «TikTok, Reels y Shorts». Separador entre los primeros (con su espacio). -->
    <string name="words_list_separator">", "</string>
    <!-- %1$s los primeros ya unidos, %2$s el último. -->
    <string name="words_list_last">%1$s e %2$s</string>
    <!-- Igual, cuando el último empieza por el sonido /i/ («Reels e Instagram»). Si tu idioma no
         cambia nada, copia la de arriba. -->
    <string name="words_list_last_i">%1$s e %2$s</string>

    <!-- Hora dentro de una frase: «a las 23:00»; %1$s es la hora («23:00»). -->
    <string name="words_at_time">às %1$s</string>
    <!-- Igual, para la una («a la 01:00»). Si tu idioma no cambia nada, copia la de arriba. -->
    <string name="words_at_time_one">à %1$s</string>

    <!-- Periodos (copy/Words.kt, CopyPeriod). Para frases con concordancia hay frases enteras por
         periodo en cada pantalla; estas son las piezas sueltas que aún se usan. -->
    <string name="period_week_noun">semana</string>
    <string name="period_week_this">esta semana</string>
    <string name="period_week_that">essa semana</string>
    <string name="period_week_previous">a semana anterior</string>
    <string name="period_month_noun">mês</string>
    <string name="period_month_this">este mês</string>
    <string name="period_month_that">esse mês</string>
    <string name="period_month_previous">o mês anterior</string>
    <string name="period_year_noun">ano</string>
    <string name="period_year_this">este ano</string>
    <string name="period_year_that">esse ano</string>
    <string name="period_year_previous">o ano anterior</string>
    <string name="period_all_noun">histórico</string>
    <string name="period_all_this">seu histórico</string>
    <string name="period_all_that">seu histórico</string>
</resources>
