<?xml version="1.0" encoding="utf-8"?>
<!--
    Reelómetro no sube nada a ningún sitio: ni la base de datos ni los ajustes entran en la copia
    de seguridad de Google ni en la transferencia entre dispositivos (ver PRIVACY.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
