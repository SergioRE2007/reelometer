<?xml version="1.0" encoding="utf-8"?>
<!--
  Pestaña Flap (copy/FlapCopy.kt): Flap, la mascota, empieza cada día a tope (100 de vida) y cada
  vídeo que ves le quita un poco. Con el objetivo diario llega a la noche a media vida y, con el
  doble, cae KO hasta mañana. A medianoche revive.
  Estados, del mejor al peor: EN FORMA, NORMAL, CANSADO, ENFERMO y KO.
  Tono: humor seco y cariñoso; Flap se pone malo, pero nadie tiene la culpa ni hay sermones.
  Nombres propios: «Flap» (la mascota) y «Reelometer» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña: el nombre de la mascota (no se traduce). -->
    <string name="flap_title">Flap</string>
    <!-- Kicker de la cabecera: «HOY · MARTES 3 NOV». %1$s el día de la semana, %2$s la fecha corta.
         Se pasa a mayúsculas sola. -->
    <string name="flap_kicker">Oggi · %1$s %2$s</string>

    <!-- ============================================================ estado de Flap -->

    <!-- Etiqueta encima del nombre del estado, en MAYÚSCULAS: «HOY FLAP ESTÁ / ENFERMO». -->
    <string name="flap_state_label">OGGI FLAP È</string>

    <!-- Nombre del estado, en MAYÚSCULAS y corto (va en grande tras «HOY FLAP ESTÁ», en la pestaña Flap). -->
    <string name="flap_mood_fit">IN FORMA</string>
    <string name="flap_mood_normal">NORMALE</string>
    <string name="flap_mood_tired">STANCO</string>
    <string name="flap_mood_sick">MALATO</string>
    <string name="flap_mood_ko">KO</string>

    <!-- El estado dentro de una frase hablada (TalkBack y la descripción del widget): en minúsculas y sin siglas («fuera de combate», no «KO»). -->
    <string name="flap_mood_spoken_fit">in forma</string>
    <string name="flap_mood_spoken_normal">normale</string>
    <string name="flap_mood_spoken_tired">stanco</string>
    <string name="flap_mood_spoken_sick">malato</string>
    <string name="flap_mood_spoken_ko">fuori combattimento</string>

    <!-- Frase de Flap en forma (ha visto pocos vídeos hoy). -->
    <string-array name="flap_phrase_fit">
        <item>Flap è al massimo. E lo sa.</item>
        <item>Flap è carico. Oggi regge tutto.</item>
        <item>Flap sembra appena uscito dalla scatola.</item>
        <item>Flap ha più energia della tua batteria appena sveglio.</item>
        <item>Flap salta come se fosse invincibile.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="flap_phrase_normal">
        <item>Flap tira avanti.</item>
        <item>Flap sta bene. Niente di che.</item>
        <item>Flap tiene botta.</item>
        <item>Flap è ancora in piedi. Senza strafare.</item>
        <item>Flap è normale. Che non è poco.</item>
    </string-array>
    <!-- Frase de Flap cansado (cerca de su aguante). -->
    <string-array name="flap_phrase_tired">
        <item>Flap ha le occhiaie.</item>
        <item>Flap sbadiglia tra un video e l’altro.</item>
        <item>Flap chiede una pausa. Ne basta una breve.</item>
        <item>Flap è agli sgoccioli.</item>
        <item>Flap non salta più. Cammina.</item>
    </string-array>
    <!-- Frase de Flap enfermo (ha pasado su aguante). Sin culpa: mañana se le pasa. -->
    <string-array name="flap_phrase_sick">
        <item>Flap ha la febbre da scroll.</item>
        <item>Flap si è misurato la febbre. Il numero non gli piace.</item>
        <item>Flap trema. Ogni video gli fa peggio.</item>
        <item>Flap è un po’ giù. Domani gli passa.</item>
        <item>Flap chiede brodo e coperta.</item>
    </string-array>
    <!-- Frase de Flap KO (el doble de su aguante). Sin dramas. Debajo de la barra ya pone «KO hasta mañana. A medianoche revive.»:
         que la frase no repita cuándo revive ni vuelva a decir «KO». -->
    <string-array name="flap_phrase_ko">
        <item>Flap è andato giù secco.</item>
        <item>Flap è al tappeto. Neanche il brodo lo rimette in piedi.</item>
        <item>Flap è crollato. Non sbatte nemmeno le palpebre.</item>
        <item>Flap non ce la fa più. Resta a terra.</item>
    </string-array>
    <!-- Frase de Flap recién llegado (la app aún no ha contado ningún vídeo). -->
    <string-array name="flap_phrase_fresh">
        <item>Flap è appena arrivato ed è al massimo.</item>
        <item>Flap comincia con tutta la vita davanti.</item>
        <item>Flap è nuovo di zecca. Non ha ancora visto neanche un video.</item>
        <item>Flap ti aspetta in piena forma. Vediamo quanto dura.</item>
    </string-array>
    <!-- Frase cuando Flap ha mejorado desde la última vez que lo viste: por un día nuevo o por un objetivo más alto (también
         a media tarde). Que no hable del día, de ayer ni de que estaba caído. Sale con cualquier mejora, también de KO a
         ENFERMO o de ENFERMO a CANSADO (al subir el objetivo o en un día nuevo con muchos vídeos ya vistos): que no dé por
         hecho que ya está bien. -->
    <string-array name="flap_phrase_recovered">
        <item>Flap si sta riprendendo un po’.</item>
        <item>Flap è messo meglio dell’ultima volta che l’hai visto.</item>
        <item>Flap respira un po’ meglio di prima.</item>
        <item>Flap è tornato e dice che sta meglio.</item>
    </string-array>

    <!-- TalkBack: Flap. %1$s el estado en minúsculas («enfermo»), %2$s la vida («32») y %3$s el máximo («100»).
         La frase de Flap se lee aparte. -->
    <string name="flap_description">Flap: %1$s, vita %2$s su %3$s.</string>
    <!-- Acción de tocar a Flap (TalkBack: «toca dos veces para saludar a Flap»). -->
    <string name="flap_tap">salutare Flap</string>

    <!-- ============================================================ vida -->

    <!-- Etiqueta de la barra de vida, en MAYÚSCULAS. -->
    <string name="flap_life">VITA</string>
    <!-- TalkBack de la barra de vida: «Vida: 62 de 100». -->
    <string name="flap_life_description">Vita: %1$s su %2$s</string>
    <!-- «HOY 31 VÍDEOS · AGUANTA 40»: %1$s los vídeos de hoy (la forma va según ellos), %2$s su aguante
         (el objetivo o, sin objetivo, 150). Se pasa a mayúsculas sola. -->
    <plurals name="flap_today_line">
        <item quantity="one">Oggi %1$s\u00A0video · ne regge %2$s</item>
        <item quantity="many">Oggi %1$s\u00A0video · ne regge %2$s</item>
        <item quantity="other">Oggi %1$s\u00A0video · ne regge %2$s</item>
    </plurals>
    <!-- Lo que falta para el siguiente estado, peor. %1$s los vídeos que faltan (la forma va según ellos). -->
    <plurals name="flap_next_normal">
        <item quantity="one">Ancora %1$s\u00A0video e non sarà più in forma.</item>
        <item quantity="many">Ancora %1$s\u00A0video e non sarà più in forma.</item>
        <item quantity="other">Ancora %1$s\u00A0video e non sarà più in forma.</item>
    </plurals>
    <plurals name="flap_next_tired">
        <item quantity="one">Ancora %1$s\u00A0video e sarà stanco.</item>
        <item quantity="many">Ancora %1$s\u00A0video e sarà stanco.</item>
        <item quantity="other">Ancora %1$s\u00A0video e sarà stanco.</item>
    </plurals>
    <plurals name="flap_next_sick">
        <item quantity="one">Ancora %1$s\u00A0video e si ammalerà.</item>
        <item quantity="many">Ancora %1$s\u00A0video e si ammalerà.</item>
        <item quantity="other">Ancora %1$s\u00A0video e si ammalerà.</item>
    </plurals>
    <plurals name="flap_next_ko">
        <item quantity="one">Ancora %1$s\u00A0video e andrà KO.</item>
        <item quantity="many">Ancora %1$s\u00A0video e andrà KO.</item>
        <item quantity="other">Ancora %1$s\u00A0video e andrà KO.</item>
    </plurals>
    <!-- Ya está KO: no hay nada peor. -->
    <string name="flap_ko_until_tomorrow">KO fino a domani. Torna a mezzanotte.</string>

    <!-- ============================================================ cómo funciona -->

    <!-- Cabecera de sección, en MAYÚSCULAS. -->
    <string name="flap_section_how">COME FUNZIONA</string>
    <!-- %1$s la vida máxima («100»). -->
    <string name="flap_how_start">Ogni giorno Flap parte al massimo, con %1$s di vita. A mezzanotte torna.</string>
    <string name="flap_how_video">Ogni video che guardi gli toglie un po’ di vita.</string>
    <!-- Con objetivo: %1$s el objetivo (la forma va según él), %2$s el doble. -->
    <plurals name="flap_how_goal">
        <item quantity="one">Al tuo obiettivo (%1$s\u00A0video) arriva a sera a metà vita; al doppio (%2$s), va KO.</item>
        <item quantity="many">Al tuo obiettivo (%1$s\u00A0video) arriva a sera a metà vita; al doppio (%2$s), va KO.</item>
        <item quantity="other">Al tuo obiettivo (%1$s\u00A0video) arriva a sera a metà vita; al doppio (%2$s), va KO.</item>
    </plurals>
    <!-- Sin objetivo: %1$s el aguante (150; la forma va según él), %2$s el doble. -->
    <plurals name="flap_how_default">
        <item quantity="one">Con %1$s\u00A0video arriva a sera a metà vita; al doppio (%2$s), va KO.</item>
        <item quantity="many">Con %1$s\u00A0video arriva a sera a metà vita; al doppio (%2$s), va KO.</item>
        <item quantity="other">Con %1$s\u00A0video arriva a sera a metà vita; al doppio (%2$s), va KO.</item>
    </plurals>
    <!-- Sin objetivo, junto al botón PONER OBJETIVO. %1$s el aguante (150; la forma va según él). -->
    <plurals name="flap_no_goal">
        <item quantity="one">Senza obiettivo, Flap regge %1$s\u00A0video al giorno. Con il tuo, regge quanto decidi tu.</item>
        <item quantity="many">Senza obiettivo, Flap regge %1$s\u00A0video al giorno. Con il tuo, regge quanto decidi tu.</item>
        <item quantity="other">Senza obiettivo, Flap regge %1$s\u00A0video al giorno. Con il tuo, regge quanto decidi tu.</item>
    </plurals>
    <!-- TalkBack del botón PONER OBJETIVO. -->
    <string name="flap_set_goal_description">Imposta un obiettivo giornaliero in Impostazioni</string>

    <!-- ============================================================ la semana -->

    <!-- Cabecera de sección, en MAYÚSCULAS. -->
    <string name="flap_section_week">LA SETTIMANA</string>
    <!-- TalkBack de un día: «Martes 3 de noviembre: 34 vídeos, cansado.». %1$s el día, %2$s los vídeos
         («34 vídeos»), %3$s el estado en minúsculas. -->
    <string name="flap_day_description">%1$s: %2$s, %3$s.</string>
    <!-- TalkBack de un día anterior a los primeros vídeos contados. %1$s el día. -->
    <string name="flap_day_description_none">%1$s: nessun dato.</string>
    <!-- Etiqueta de la racha, en MAYÚSCULAS. -->
    <string name="flap_streak_label">SERIE</string>
    <!-- Días cerrados seguidos sin pasar del aguante. %1$s los días (la forma va según ellos). -->
    <plurals name="flap_streak">
        <item quantity="one">%1$s\u00A0giorno di fila senza ammalarsi</item>
        <item quantity="many">%1$s\u00A0giorni di fila senza ammalarsi</item>
        <item quantity="other">%1$s\u00A0giorni di fila senza ammalarsi</item>
    </plurals>
</resources>
