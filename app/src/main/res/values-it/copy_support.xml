<?xml version="1.0" encoding="utf-8"?>
<!--
  Aviso de apoyo (copy/SupportCopy.kt): un único aviso grande y centrado que sale como mucho dos
  veces y lleva al GitHub del proyecto. Sin prometer nada que la app no haga: no tiene internet; el
  enlace lo abre el navegador. «GitHub» no se traduce.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- Antetítulo en MAYÚSCULAS, muy corto. -->
    <string name="support_kicker">UNA COSA</string>
    <string name="support_title">Quest’app la fa uno studente.</string>
    <string name="support_text">Reelómetro è gratis, non ha pubblicità e i tuoi dati non escono dal telefono. La fa uno studente nel tempo libero. Sul suo GitHub puoi vedere come è fatta e, se ti va, sostenerla.</string>
    <!-- Pie pequeño bajo el texto: qué pasa al pulsar. -->
    <string name="support_note">Si apre nel browser. L’app continua a non avere internet.</string>
    <!-- Botón principal en MAYÚSCULAS. -->
    <string name="support_open">VEDI IL SUO GITHUB</string>
    <!-- Enlace pequeño para no volver a ver el aviso. -->
    <string name="support_never">Non mostrare più</string>
    <!-- Si no se pudo abrir el navegador. %1$s la dirección del proyecto sin «https://github.com/» («usuario/proyecto»). -->
    <string name="support_open_failed">Non è stato possibile aprire il browser. Cercalo su GitHub: %1$s.</string>

    <!-- TalkBack: título del aviso y de los botones. -->
    <string name="support_pane_title">Sostieni Reelómetro</string>
    <string name="support_open_description">Vedi il suo GitHub. Si apre nel browser</string>
    <string name="support_never_description">Non mostrare più questo avviso</string>
</resources>
