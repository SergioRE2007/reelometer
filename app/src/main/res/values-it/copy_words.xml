<?xml version="1.0" encoding="utf-8"?>
<!--
  Palabras compartidas por toda la app (copy/Words.kt): recuentos con plural, duraciones con
  palabras, listas, horas y periodos. %1$s es siempre la cifra ya formateada («1.234»).
  \u00A0 es un espacio duro: la cifra y su palabra no se separan al partir la línea.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- Recuentos: «1 vídeo», «212 vídeos». En italiano «many» es solo para millones exactos («1.000.000 di video»). -->
    <plurals name="words_videos">
        <item quantity="one">%1$s\u00A0video</item>
        <item quantity="many">%1$s\u00A0di video</item>
        <item quantity="other">%1$s\u00A0video</item>
    </plurals>
    <plurals name="words_times">
        <item quantity="one">%1$s\u00A0volta</item>
        <item quantity="many">%1$s\u00A0di volte</item>
        <item quantity="other">%1$s\u00A0volte</item>
    </plurals>
    <plurals name="words_days">
        <item quantity="one">%1$s\u00A0giorno</item>
        <item quantity="many">%1$s\u00A0di giorni</item>
        <item quantity="other">%1$s\u00A0giorni</item>
    </plurals>
    <plurals name="words_hours">
        <item quantity="one">%1$s\u00A0ora</item>
        <item quantity="many">%1$s\u00A0di ore</item>
        <item quantity="other">%1$s\u00A0ore</item>
    </plurals>
    <plurals name="words_minutes">
        <item quantity="one">%1$s\u00A0minuto</item>
        <item quantity="many">%1$s\u00A0di minuti</item>
        <item quantity="other">%1$s\u00A0minuti</item>
    </plurals>
    <plurals name="words_seconds">
        <item quantity="one">%1$s\u00A0secondo</item>
        <item quantity="many">%1$s\u00A0di secondi</item>
        <item quantity="other">%1$s\u00A0secondi</item>
    </plurals>

    <!-- Duraciones dentro de una frase: «un segundo», «45 segundos», «un minuto», «47 minutos»,
         «una hora», «3 horas». En español el 1 va en letra; en idiomas donde «one» abarca más
         números (ruso: 21, 31…), escribe la cifra con %1$s. -->
    <plurals name="words_duration_seconds">
        <item quantity="one">un secondo</item>
        <item quantity="many">%1$s\u00A0di secondi</item>
        <item quantity="other">%1$s\u00A0secondi</item>
    </plurals>
    <plurals name="words_duration_minutes">
        <item quantity="one">un minuto</item>
        <item quantity="many">%1$s\u00A0di minuti</item>
        <item quantity="other">%1$s\u00A0minuti</item>
    </plurals>
    <plurals name="words_duration_hours">
        <item quantity="one">un’ora</item>
        <item quantity="many">%1$s\u00A0di ore</item>
        <item quantity="other">%1$s\u00A0ore</item>
    </plurals>
    <!-- «una hora y 12 minutos»: %1$s las horas, %2$s los minutos (ya con sus palabras). -->
    <string name="words_duration_hours_minutes">%1$s e %2$s</string>

    <!-- Listas: «TikTok, Reels y Shorts». Separador entre los primeros (con su espacio). -->
    <string name="words_list_separator">", "</string>
    <!-- %1$s los primeros ya unidos, %2$s el último. -->
    <string name="words_list_last">%1$s e %2$s</string>
    <!-- Igual, cuando el último empieza por el sonido /i/ («Reels e Instagram»). Si tu idioma no
         cambia nada, copia la de arriba. -->
    <string name="words_list_last_i">%1$s ed %2$s</string>

    <!-- Hora dentro de una frase: «a las 23:00»; %1$s es la hora («23:00»). -->
    <string name="words_at_time">alle %1$s</string>
    <!-- Igual, para la una («a la 01:00»). Si tu idioma no cambia nada, copia la de arriba. -->
    <string name="words_at_time_one">all’%1$s</string>

    <!-- Periodos (copy/Words.kt, CopyPeriod). Para frases con concordancia hay frases enteras por
         periodo en cada pantalla; estas son las piezas sueltas que aún se usan. -->
    <string name="period_week_noun">settimana</string>
    <string name="period_week_this">questa settimana</string>
    <string name="period_week_that">quella settimana</string>
    <string name="period_week_previous">la settimana scorsa</string>
    <string name="period_month_noun">mese</string>
    <string name="period_month_this">questo mese</string>
    <string name="period_month_that">quel mese</string>
    <string name="period_month_previous">il mese scorso</string>
    <string name="period_year_noun">anno</string>
    <string name="period_year_this">quest’anno</string>
    <string name="period_year_that">quell’anno</string>
    <string name="period_year_previous">l’anno scorso</string>
    <string name="period_all_noun">storico</string>
    <string name="period_all_this">il tuo storico</string>
    <string name="period_all_that">il tuo storico</string>
</resources>
