<?xml version="1.0" encoding="utf-8"?>
<!--
  Envío rápido (copy/QuickSendCopy.kt): burbujas que pone la app sobre los vídeos de Instagram y TikTok
  para compartirlos con un toque. Las burbujas no llevan texto visible: casi todo es para TalkBack,
  más la pregunta de si apagarlo. %1$s es siempre el nombre de una persona o un grupo de esa app.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- TalkBack de cada burbuja, según su estado. -->
    <string name="quicksend_bubble_description">Invia questo video a %1$s</string>
    <string name="quicksend_sending_description">Invio a %1$s</string>
    <string name="quicksend_sent_description">Inviato a %1$s</string>
    <!-- No ha encontrado algo: si la hoja de compartir se abrió, se queda abierta para terminar a mano. -->
    <string name="quicksend_failed_description">Non sono riuscito a inviarlo a %1$s</string>
    <!-- Acción de TalkBack: enviar a dos a la vez. %1$s esta burbuja, %2$s otra persona o grupo fijado. -->
    <string name="quicksend_pair_action">Invia a %1$s e a %2$s</string>
    <!-- Acción de TalkBack en cada burbuja (equivale a soltarla en la «X»). -->
    <string name="quicksend_hide_action">Nascondi fino al video successivo</string>
    <!-- Nombre de la ventana de las burbujas (TalkBack la anuncia así). -->
    <string name="quicksend_window_title">Invio rapido di Reelometer</string>
    <!-- La zona «X» que sale abajo mientras arrastras las burbujas. -->
    <string name="quicksend_zone_title">Rilascia qui per nascondere</string>

    <!-- Pregunta tras esconder las burbujas tres veces seguidas (sale una sola vez).
         «A quién envías» es el nombre del ajuste de la app (settings_recipients_label). -->
    <string name="quicksend_ask_title">Spengo l’invio rapido?</string>
    <string name="quicksend_ask_body">Hai nascosto le bolle tre volte di fila. Se lo spegni, lo riaccendi nelle Impostazioni, sotto «A chi invii».</string>
    <!-- Botones en MAYÚSCULAS, muy cortos. -->
    <string name="quicksend_ask_turn_off">SPEGNI</string>
    <string name="quicksend_ask_keep">LASCIALO</string>
</resources>
