    <string name="settings_time_hour_up">Un’ora in più</string>
    <string name="settings_time_minute_down">Cinque minuti in meno</string>
    <string name="settings_time_minute_up">Cinque minuti in più</string>

    <!-- Con los avisos bloqueados en Android (va con el botón ABRIR AJUSTES). -->
    <string name="settings_notifications_blocked">Android ha disattivato gli avvisi di Reelometer. Attivali nelle impostazioni del sistema per riceverli.</string>

    <!-- ============================================================ 03 apps -->

    <!-- Con todas las apps apagadas. -->
    <string name="settings_all_apps_off">Le hai spente tutte. Così non c’è niente da contare.</string>

    <!-- Interruptor «A quién envías» (Instagram y TikTok). «Estadísticas» es la pestaña de la app. -->
    <string name="settings_recipients_label">A chi invii</string>
    <string name="settings_recipients_description">Su Instagram e TikTok. Quando condividi un video, segno il nome della persona o del gruppo che scegli, e in Statistiche vedi a chi invii di più. Non leggo la chat né quello che scrivi, e resta su questo telefono.</string>

    <!-- Interruptor «Envío rápido» (Instagram y TikTok): unas burbujas sobre los vídeos que los comparten
         con un toque. «Compartir» y «Enviar» citan los botones de Instagram y TikTok tal cual: en cada idioma,
         como los muestren esas apps en ese idioma. «X» es la zona donde se sueltan las burbujas.
         Italiano: Instagram y TikTok dicen las dos «Condividi» y «Invia» (TikTok titula la hoja «Invia a»). -->
    <string name="settings_quick_send_label">Invio rapido</string>
    <string name="settings_quick_send_description">Su Instagram e TikTok. Mentre guardi i video compare una bolla per ogni persona o gruppo che fissi in quell’app. Quando la tocchi, premo per te «Condividi», quel nome e «Invia»; se non lo vedo, lo cerco nella barra di ricerca del foglio (su TikTok, toccando prima la sua lente). Nient’altro. Se qualcosa non torna, mi fermo e finisci tu. Per mostrare la sua foto nella bolla, la ritaglio dal foglio di condivisione quando compare, oppure scegli tu una foto dalla galleria; resta su questo telefono. Trascinale dove vuoi (in basso, sopra il nome del video, si mettono in fila) o rilasciale sulla «X» per nasconderle fino al video successivo.</string>
    <!-- El gesto para enviar a dos personas a la vez. -->
    <string name="settings_quick_send_pair_hint">Per mandarlo a due persone insieme, tieni premuta una bolla finché non si stacca e rilasciala sopra l’altra. Se ne tocchi un’altra mentre sto inviando, la aggiungo allo stesso foglio.</string>
    <!-- Con «A quién envías» apagado, el envío rápido no se puede encender. -->
    <string name="settings_quick_send_needs_recipients">Per usarlo, attiva prima «A chi invii»: l’invio rapido cerca nel foglio il nome che fissi.</string>
    <!-- Botones de cada fila, en MAYÚSCULAS y con poco sitio: fijar a alguien / ya fijado. -->
    <string name="settings_quick_send_pin">FISSA</string>
    <string name="settings_quick_send_pinned">FISSATO</string>
    <!-- Botón en MAYÚSCULAS: devuelve las burbujas de esa app a su sitio por defecto (borde derecho;
         la altura depende de la app, ver BubbleLayout.defaultFor). -->
    <string name="settings_quick_send_relocate">RIPOSIZIONA</string>
    <!-- Ya hay el máximo de fijados. %1$s el máximo («3»). -->
    <plurals name="settings_quick_send_full">
        <item quantity="one">Hai già %1$s fissato. Rimuovilo per fissarne un altro.</item>
        <item quantity="many">Hai già %1$s fissati. Rimuovine uno per fissarne un altro.</item>
        <item quantity="other">Hai già %1$s fissati. Rimuovine uno per fissarne un altro.</item>
    </plurals>
    <!-- TalkBack, en cada fila. %1$s el nombre de la persona o el grupo. -->
    <string name="settings_quick_send_pin_description">Fissa %1$s nell’invio rapido</string>
    <string name="settings_quick_send_unpin_description">Rimuovi %1$s dall’invio rapido</string>
    <!-- Botones en MAYÚSCULAS bajo cada fijado: elegir de la galería la foto de su burbuja, cambiarla o quitarla. -->
    <string name="settings_quick_send_photo_pick">SCEGLI FOTO</string>
    <string name="settings_quick_send_photo_change">CAMBIA FOTO</string>
    <string name="settings_quick_send_photo_clear">RIMUOVI FOTO</string>
    <string name="settings_quick_send_photo_set">Foto impostata. La vedrai nella sua bolla; resta solo su questo telefono.</string>
    <string name="settings_quick_send_photo_cleared">Foto rimossa. Torna quella automatica o, se non c’è, le iniziali.</string>
    <string name="settings_quick_send_photo_failed">Non sono riuscito ad aprire quella foto. Prova con un’altra.</string>
    <!-- TalkBack de esos botones. %1$s el nombre de la persona o el grupo. -->
    <string name="settings_quick_send_photo_pick_description">Scegli dalla galleria la foto della bolla di %1$s</string>
    <string name="settings_quick_send_photo_change_description">Cambia la foto della bolla di %1$s con un’altra della galleria</string>
    <string name="settings_quick_send_photo_clear_description">Rimuovi la foto scelta per %1$s e torna a quella automatica</string>

    <!-- 1.10.0, envío rápido en Instagram y en TikTok: cada app tiene sus fijados y su sitio para las burbujas.
         Va encima de las dos pestañas con el nombre de cada app (INSTAGRAM, TIKTOK: las marcas no se traducen). -->
    <string name="settings_quick_send_apps_hint">Ogni app ha le sue persone fissate e il suo posto per le bolle: i tuoi contatti di TikTok non sono quelli di Instagram.</string>
    <!-- TalkBack de cada pestaña. %1$s el nombre de la app («TikTok», «Instagram»). -->
