<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de Ajustes (copy/SettingsCopy.kt): una lista editorial de 8 secciones numeradas
  («01  OBJETIVO ─────» + descripción). Habla la app en primera persona («te aviso», «cuento»).
  Los textos en MAYÚSCULAS se ven así en pantalla (etiquetas y botones): escríbelos en mayúsculas.
  Los botones y etiquetas tienen poco sitio: mejor cortos.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- Título de la pantalla (barra de arriba). -->
    <string name="settings_title">Impostazioni</string>

    <!-- Secciones: título en MAYÚSCULAS (cabecera numerada, poco sitio) y descripción bajo él. -->
    <string name="settings_section_goal_title">OBIETTIVO</string>
    <string name="settings_section_goal_description">Un massimo di video al giorno. Serve per il «ti restano» di Oggi e per le serie.</string>
    <string name="settings_section_notifications_title">AVVISI</string>
    <string name="settings_section_notifications_description">Un riepilogo al giorno, all’ora che scegli, e uno al mese.</string>
    <string name="settings_section_apps_title">QUALI APP CONTO</string>
    <string name="settings_section_apps_description">Quello che spegni qui smette di essere contato all’istante. Quello già contato resta.</string>
    <!-- Sección del tema (claro, oscuro o el del sistema); también lleva la fila del idioma. -->
    <string name="settings_section_theme_title">TEMA</string>
    <string name="settings_section_theme_description">Il contatore rende di più al buio, ma decidi tu.</string>
    <string name="settings_section_data_title">I TUOI DATI</string>
    <string name="settings_section_data_description">Tutto quello che ho contato sta su questo telefono. Puoi portartelo via, riportarlo qui o cancellarlo.</string>
    <string name="settings_section_service_title">SERVIZIO</string>
    <string name="settings_section_service_description">Il permesso di accessibilità è quello che mi fa contare. Qui vedi se è attivo.</string>
    <string name="settings_section_privacy_title">PRIVACY</string>
    <string name="settings_section_privacy_description">Cosa succede ai tuoi dati, senza scritte in piccolo.</string>
    <string name="settings_section_about_title">INFO</string>
    <string name="settings_section_about_description">Reelometer non ha niente a che vedere con TikTok, Instagram o YouTube. Conta solo quello che vedi lì.</string>

    <!-- Antetítulo de los diálogos que salen de una sección: «05 · TUS DATOS». %1$s el número de la
