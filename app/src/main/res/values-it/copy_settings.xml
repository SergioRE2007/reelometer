    <!-- Línea del selector: «Vídeos al día ······ [ − 150 + ]». -->
    <string name="settings_goal_line">Video al giorno</string>
    <!-- Interruptor del modo Pasaporte (un juego que premia ver menos; «Flap» es su mascota, no se traduce). -->
    <string name="settings_passport_label">Modalità passaporto</string>
    <string name="settings_passport_description">Una scheda in più con Flap, livelli e timbri che si guadagnano guardando meno. Se la spegni, sparisce del tutto: la scheda, il suo avviso e Flap nel widget.</string>

    <!-- ============================================================ 02 avisos -->

    <string name="settings_daily_label">Riepilogo giornaliero</string>
    <!-- Bajo el resumen diario: «Tu cuenta del día, a las 21:30.». %1$s la hora con su preposición («a las 21:30»). -->
    <string name="settings_daily_description">Il tuo conteggio del giorno, %1$s.</string>
    <!-- Línea que abre el selector de hora (a la derecha va la hora, «21:30»). -->
    <string name="settings_time_label">Orario dell’avviso</string>
    <string name="settings_monthly_label">Riepilogo mensile</string>
    <string name="settings_monthly_description">Il giorno 1, il mese precedente conteggiato, con il suo riepilogo.</string>
    <!-- Aviso en directo al pasar el objetivo (apagado por defecto). -->
    <string name="settings_goal_live_label">Avviso al superamento dell’obiettivo</string>
    <!-- %1$s el objetivo con su palabra («150 vídeos»). -->
    <string name="settings_goal_live_description">Un solo avviso al giorno, appena superi %1$s.</string>
    <!-- Lo mismo sin objetivo: explica por qué no se puede encender. -->
    <string name="settings_goal_live_needs_goal">Serve un obiettivo. Impostalo sopra e ti avviso appena lo superi.</string>

