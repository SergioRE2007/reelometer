    <string name="settings_index_notifications">Avvisi</string>
    <string name="settings_index_apps">App</string>
    <string name="settings_index_theme">Tema</string>
    <string name="settings_index_data">I tuoi dati</string>
    <string name="settings_index_service">Servizio</string>
    <string name="settings_index_privacy">Privacy</string>
    <string name="settings_index_about">Info</string>
