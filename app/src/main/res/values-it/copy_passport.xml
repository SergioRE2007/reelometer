<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo Pasaporte (copy/PassportCopy.kt): pestaña con Flap (la mascota), la tarjeta de embarque
  (niveles y millas), los sellos, el reto semanal contra «tu fantasma» (tú la semana pasada), las
  celebraciones y el ticket de nivel que se comparte como imagen.
  Tono: aeropuerto, tarjeta de embarque, ironía amable. Premia ver menos y nunca culpa.
  Las millas salen de ver MENOS vídeos (días bajo la referencia, rachas, retos y sellos), nunca de verlos.
  Nombres propios: «Flap» (la mascota) y «Reelómetro» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña y nombre del modo (palabra normal: tradúcela). -->
    <string name="passport_title">Passaporto</string>

    <!-- Cabeceras de sección, en MAYÚSCULAS. «FLAP» es el nombre de la mascota (no se traduce). -->
    <string name="passport_section_flap">FLAP</string>
    <string name="passport_section_level">CARTA D\'IMBARCO</string>
    <string name="passport_section_challenge">SFIDA DELLA SETTIMANA</string>
    <string name="passport_section_stamps">TIMBRI</string>
    <string name="passport_section_past">SFIDE PRECEDENTI</string>

    <!-- Kicker de la cabecera: «63 DÍAS A BORDO». %1$s son los días («63 días»). Se pasa a mayúsculas sola. -->
    <string name="passport_on_board">%1$s a bordo</string>

    <!-- ============================================================ Flap (la mascota) -->

    <!-- Estado de Flap, en MAYÚSCULAS y corto (etiqueta junto al dibujo). En TalkBack se lee en minúsculas. -->
    <string name="passport_mood_fit">IN FORMA</string>
    <string name="passport_mood_normal">NORMALE</string>
    <string name="passport_mood_tired">STANCO</string>
    <string name="passport_mood_zombie">ZOMBIE DA SCROLL</string>
    <!-- Estado mientras Flap no tiene con qué comparar (ni objetivo ni historial). MAYÚSCULAS. -->
    <string name="passport_warming_up">RISCALDAMENTO</string>

    <!-- Frase de Flap en forma (la semana va bien). -->
    <string-array name="passport_phrase_fit">
        <item>Flap va alla grande questa settimana.</item>
        <item>Flap è in gran forma. Anche tu, anche se non sembra.</item>
        <item>Flap non si ricorda più cosa fosse lo scroll.</item>
        <item>Flap ha ricominciato a guardare dal finestrino.</item>
        <item>Flap si è iscritto a correre. Per ora regge.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="passport_phrase_normal">
        <item>Flap tira avanti.</item>
        <item>Flap, così così.</item>
        <item>Flap regge il colpo.</item>
        <item>Flap è come la tua settimana: nella norma.</item>
        <item>Flap né bene né male. Flap e basta.</item>
    </string-array>
    <!-- Frase de Flap cansado (la semana va regular). -->
    <string-array name="passport_phrase_tired">
        <item>Flap ha le occhiaie.</item>
        <item>Flap ha dormito poco e si vede.</item>
        <item>Flap chiede una pausa. Gli basta un giorno tranquillo.</item>
        <item>Flap sbadiglia tra un video e l\'altro.</item>
        <item>Flap è stanco, ma non molla.</item>
    </string-array>
    <!-- Frase de Flap zombi (mucho scroll). Sin culpa: siempre se puede recuperar. -->
    <string-array name="passport_phrase_zombie">
        <item>Flap cammina con le braccia in avanti.</item>
        <item>Flap ormai dice solo «ancora uno».</item>
        <item>Flap è uno zombie dello scroll. Guarisce con un giorno tranquillo.</item>
        <item>Flap non muore. Sta solo attraversando una brutta serie.</item>
        <item>Flap si riprende appena passa un giorno.</item>
    </string-array>
    <!-- Frase mientras Flap calienta (sin objetivo ni historial suficiente). -->
    <string-array name="passport_phrase_warming">
        <item>Flap sta ancora imparando a conoscerti. Dagli qualche giorno.</item>
        <item>Senza obiettivo né storico, Flap non giudica. Ancora no.</item>
        <item>Flap sta facendo stretching. Tra qualche giorno ti dirà qualcosa.</item>
        <item>Primi giorni: Flap osserva e prende appunti.</item>
    </string-array>
    <!-- Frase cuando Flap vuelve de zombi a normal o mejor. -->
    <string-array name="passport_phrase_recovered">
        <item>Flap è tornato dal mondo dei vivi.</item>
        <item>Né zombie né niente: Flap si è ripreso.</item>
        <item>Flap ha ricominciato a sbattere le palpebre normalmente.</item>
        <item>Flap è tornato. Dice di non ricordare nulla.</item>
    </string-array>

