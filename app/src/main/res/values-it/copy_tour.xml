<?xml version="1.0" encoding="utf-8"?>
<!--
  Recorrido guiado de la primera vez (copy/TourCopy.kt): marcas sobre las pantallas reales con un
  título y una frase corta. Poco sitio: las frases tienen que caber con la letra al 130 % encima o
  debajo del elemento señalado. Siempre dice lo mismo (sin variantes).
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- Botones en MAYÚSCULAS, muy cortos. -->
    <string name="tour_skip">SALTA</string>
    <string name="tour_done">FATTO</string>
    <!-- Contador en MAYÚSCULAS: «PASO 2 DE 6». %1$s el paso, %2$s el total. -->
    <string name="tour_step">PASSO %1$s DI %2$s</string>

    <!-- TalkBack: título del panel y de los botones. -->
    <string name="tour_pane_title">Tour di Reelometer</string>
    <string name="tour_skip_description">Salta il tour</string>
    <string name="tour_next_description">Passo successivo del tour</string>
    <string name="tour_done_description">Termina il tour</string>

    <!-- Título corto de cada paso (sin punto final). -->
    <!-- El marcador grande de Hoy con los vídeos del día. -->
    <string name="tour_counter_title">Il contatore</string>
    <!-- La comparación con el día medio a la misma hora. -->
    <string name="tour_comparison_title">A quest’ora</string>
    <!-- Las barras de Estadísticas. -->
    <string name="tour_stats_bars_title">Ogni giorno, una barra</string>
    <!-- La pestaña del resumen (semana, mes, año). -->
    <string name="tour_wrapped_title">Il riepilogo</string>
    <!-- La pestaña del pasaporte (Flap es la mascota: no se traduce). -->
    <string name="tour_passport_title">Il passaporto</string>
    <string name="tour_settings_title">Impostazioni e calibrazione</string>

    <!-- Frase de cada paso. -->
    <string name="tour_counter_text">I tuoi video di oggi. Il contatore sale da solo a ogni video e torna a zero a mezzanotte.</string>
    <string name="tour_comparison_text">Come vai rispetto al tuo giorno medio a quest’ora. Nessun giudizio, solo cifre.</string>
    <!-- Lo mismo cuando aún no hay comparación (faltan días): no señala nada. -->
    <string name="tour_comparison_text_empty">Con qualche giorno contato, qui vedrai come vai rispetto al tuo giorno medio a quest’ora.</string>
    <string name="tour_stats_bars_text">Tieni il dito su una barra e scorri per vedere la cifra esatta di ogni giorno.</string>
    <string name="tour_wrapped_text">La tua settimana, il tuo mese e il tuo anno, raccontati come una storia. Con lo scontrino da condividere, se hai coraggio.</string>
    <string name="tour_passport_text">Flap e i tuoi timbri. Qui l’esperienza si guadagna guardando meno, mai di più.</string>
    <string name="tour_settings_text">Obiettivo, avvisi e tema, qui in alto. Sette tocchi sulla versione aprono la calibrazione.</string>

    <!-- Lo que anuncia TalkBack al llegar a cada paso: «Paso 2 de 6. A esta hora. Cómo vas…».
         %1$s el paso, %2$s el total, %3$s el título del paso (sin punto), %4$s su frase (con punto). -->
    <string name="tour_announcement">Passo %1$s di %2$s. %3$s. %4$s</string>
</resources>
