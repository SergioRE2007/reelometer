<?xml version="1.0" encoding="utf-8"?>
<!--
  Detalle de un día (copy/DayCopy.kt): se abre al tocar el marcador o una barra del calendario.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). Los arrays con sufijo (_one, _notime, _noeq) son la
  misma situación en otro caso gramatical: mantén el mismo sentido en cada posición.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">

    <!-- Título en frase. %1$s es la fecha larga («martes 3 de noviembre»). -->
    <string name="day_title_today">Oggi, %1$s</string>
    <string name="day_title_yesterday">Ieri, %1$s</string>

    <!-- Etiqueta en MAYÚSCULAS (se pasa a mayúsculas sola): «MARTES 3 NOV». %1$s día de la semana,
         %2$s fecha corta («3 nov» o «3 nov 2025»). -->
    <string name="day_label_date">%1$s %2$s</string>
    <!-- «HOY · MARTES 3 NOV»: %1$s es la etiqueta de arriba, ya en mayúsculas. -->
    <string name="day_label_today">OGGI · %1$s</string>
    <string name="day_label_yesterday">IERI · %1$s</string>

    <!-- Frase de un día pasado, cero vídeos. -->
    <string-array name="day_zero">
        <item>Quel giorno, nemmeno un video.</item>
        <item>Zero. Una giornata da ricordare, o senza campo.</item>
        <item>Niente quel giorno. O non guardavi nulla, o io non stavo guardando.</item>
    </string-array>

    <!-- Con objetivo, pasado: %1$s lo que se pasó («62 vídeos»), %2$s el objetivo, %3$s los vídeos del día. -->
    <string-array name="day_goal_over">
        <item>Quel giorno hai sforato di %1$s.</item>
        <item>Obiettivo: %2$s. Quel giorno: %3$s.</item>
        <item>%1$s sopra l’obiettivo. Capita.</item>
    </string-array>
    <!-- Con objetivo, justo en el límite: %1$s el objetivo. -->
    <string-array name="day_goal_at">
        <item>Proprio al limite: %1$s, né uno di più.</item>
        <item>%1$s su %1$s. Centrato.</item>
        <item>Obiettivo centrato quel giorno.</item>
    </string-array>
    <!-- Con objetivo, por debajo: %1$s los vídeos del día, %2$s el objetivo, %3$s el margen («38 vídeos»). -->
    <string-array name="day_goal_under">
        <item>Dentro l’obiettivo: %1$s su %2$s.</item>
        <item>Sotto %2$s, con %3$s di margine.</item>
        <item>%1$s su %2$s. Giornata entro il limite.</item>
    </string-array>

    <!-- Día flojo (1–9 vídeos): %1$s los vídeos («3 vídeos»), %2$s el tiempo («2 minutos»).
         _one: un solo vídeo. _notime: menos de un minuto (sin tiempo en la frase). -->
    <string-array name="day_first">
        <item>Quel giorno sono stati %1$s. Quasi niente.</item>
        <item>%1$s e %2$s. Una giornata tranquilla.</item>
        <item>Poca roba: %1$s.</item>
    </string-array>
    <string-array name="day_first_notime">
        <item>Quel giorno sono stati %1$s. Quasi niente.</item>
        <item>%1$s. Una giornata tranquilla.</item>
        <item>Poca roba: %1$s.</item>
    </string-array>
    <string-array name="day_first_one">
        <item>Quel giorno è stato %1$s. Quasi niente.</item>
        <item>%1$s e %2$s. Una giornata tranquilla.</item>
        <item>Poca roba: %1$s.</item>
    </string-array>
    <string-array name="day_first_one_notime">
        <item>Quel giorno è stato %1$s. Quasi niente.</item>
        <item>%1$s. Una giornata tranquilla.</item>
        <item>Poca roba: %1$s.</item>
    </string-array>

    <!-- Día normal: %1$s los vídeos, %2$s el tiempo («47 minutos»), %3$s el tiempo con mayúscula
         inicial (para empezar la frase con él). -->
    <string-array name="day_normal">
        <item>%1$s e %2$s. Una giornata normale, che è già dire.</item>
        <item>Quel giorno: %2$s di video.</item>
        <item>%3$s. Né carne né pesce.</item>
    </string-array>

    <!-- Día alto: %1$s los vídeos, %2$s el tiempo con mayúscula inicial, %3$s el tiempo, %4$s una
         equivalencia en infinitivo («leer 14 libros»). _noeq: sin equivalencia (no uses %4$s).
         _one: el tiempo es singular («una hora y 40 minutos»). -->
    <string-array name="day_high">
        <item>%1$s. Quel giorno l’algoritmo ha fatto gli straordinari.</item>
        <item>%2$s di video. Ti bastava per %4$s.</item>
        <item>Quel giorno sono sfumati %3$s. Così, senza storie.</item>
    </string-array>
    <string-array name="day_high_noeq">
        <item>%1$s. Quel giorno l’algoritmo ha fatto gli straordinari.</item>
        <item>%2$s di video. Una giornata lunga.</item>
        <item>Quel giorno sono sfumati %3$s. Così, senza storie.</item>
    </string-array>
    <string-array name="day_high_one">
        <item>%1$s. Quel giorno l’algoritmo ha fatto gli straordinari.</item>
        <item>%2$s di video. Ti bastava per %4$s.</item>
        <item>Quel giorno è sfumato %3$s. Così, senza storie.</item>
    </string-array>
    <string-array name="day_high_one_noeq">
        <item>%1$s. Quel giorno l’algoritmo ha fatto gli straordinari.</item>
        <item>%2$s di video. Una giornata lunga.</item>
        <item>Quel giorno è sfumato %3$s. Così, senza storie.</item>
    </string-array>

    <!-- Día extremo: %1$s los vídeos, %2$s el tiempo con mayúscula inicial. -->
    <string-array name="day_extreme">
        <item>%1$s. Ci sono giorni e giorni, e questo era di quelli da record.</item>
        <item>%2$s. Se qualcuno chiede, avevi delle cose da fare.</item>
        <item>%1$s in un solo giorno. Quel giorno ha vinto l’algoritmo.</item>
    </string-array>

    <!-- Puesto del día entre todos los contados (MAYÚSCULAS). -->
    <string name="day_rank_record">IL TUO RECORD: IL GIORNO CON PIÙ VIDEO</string>
    <!-- %1$s el puesto, %2$s los días contados (siempre 2 o más). -->
    <plurals name="day_rank_line">
        <item quantity="one">N° %1$s DI %2$s GIORNO CONTATO</item>
        <item quantity="many">N° %1$s DI %2$s GIORNI CONTATI</item>
        <item quantity="other">N° %1$s DI %2$s GIORNI CONTATI</item>
    </plurals>

    <!-- Estado frente al objetivo de un día cerrado (MAYÚSCULAS, columna estrecha: corto). %1$s cifra. -->
    <string name="day_goal_status_over">+%1$s\u00A0OLTRE</string>
    <string name="day_goal_status_at">AL LIMITE</string>
    <string name="day_goal_status_under">%1$s\u00A0SOTTO</string>

    <!-- Lo mismo para TalkBack: %1$s la diferencia («38 vídeos»), %2$s el objetivo. -->
    <string name="day_goal_status_over_description">%1$s oltre l’obiettivo di %2$s</string>
    <!-- %1$s el objetivo. -->
    <string name="day_goal_status_at_description">Proprio sull’obiettivo di %1$s</string>
    <string name="day_goal_status_under_description">%1$s sotto l’obiettivo di %2$s</string>

    <!-- Cabecera de la sección por horas de un día pasado (MAYÚSCULAS). -->
    <string name="day_section_hours">QUEL GIORNO, ORA PER ORA</string>
    <!-- «PRIMER VÍDEO 08:12 · ÚLTIMO 01:47»: %1$s hora del primero, %2$s del último. -->
    <string name="day_first_last">PRIMO VIDEO %1$s · ULTIMO %2$s</string>
</resources>
