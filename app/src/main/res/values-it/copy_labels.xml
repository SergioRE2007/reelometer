    <string name="label_no_signal">SENZA SEGNALE</string>
    <!-- La hora del día con más vídeos. -->
    <string name="label_peak_hour">ORA DI PUNTA</string>
    <string name="label_weak_day">GIORNO DEBOLE</string>
    <string name="label_worst_day">PEGGIOR GIORNO</string>
