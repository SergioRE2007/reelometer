<?xml version="1.0" encoding="utf-8"?>
<!--
  Pestaña Flap (copy/FlapCopy.kt): Flap, la mascota, empieza cada día a tope (100 de vida) y cada
  vídeo que ves le quita un poco. Con el objetivo diario llega a la noche a media vida y, con el
  doble, cae KO hasta mañana. A medianoche revive.
  Estados, del mejor al peor: EN FORMA, NORMAL, CANSADO, ENFERMO y KO.
  Tono: humor seco y cariñoso; Flap se pone malo, pero nadie tiene la culpa ni hay sermones.
  Nombres propios: «Flap» (la mascota) y «Reelometer» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña: el nombre de la mascota (no se traduce). -->
    <string name="flap_title">Flap</string>
    <!-- Kicker de la cabecera: «HOY · MARTES 3 NOV». %1$s el día de la semana, %2$s la fecha corta.
         Se pasa a mayúsculas sola. -->
    <string name="flap_kicker">Aujourd’hui · %1$s %2$s</string>

    <!-- ============================================================ estado de Flap -->

    <!-- Etiqueta encima del nombre del estado, en MAYÚSCULAS: «HOY FLAP ESTÁ / ENFERMO». -->
    <string name="flap_state_label">AUJOURD’HUI, FLAP EST</string>

    <!-- Nombre del estado, en MAYÚSCULAS y corto (va en grande tras «HOY FLAP ESTÁ», en la pestaña Flap). -->
    <string name="flap_mood_fit">EN FORME</string>
    <string name="flap_mood_normal">NORMAL</string>
    <string name="flap_mood_tired">FATIGUÉ</string>
    <string name="flap_mood_sick">MALADE</string>
    <string name="flap_mood_ko">KO</string>

    <!-- El estado dentro de una frase hablada (TalkBack y la descripción del widget): en minúsculas y sin siglas («fuera de combate», no «KO»). -->
    <string name="flap_mood_spoken_fit">en forme</string>
    <string name="flap_mood_spoken_normal">normal</string>
    <string name="flap_mood_spoken_tired">fatigué</string>
    <string name="flap_mood_spoken_sick">malade</string>
    <string name="flap_mood_spoken_ko">hors de combat</string>

    <!-- Frase de Flap en forma (ha visto pocos vídeos hoy). -->
    <string-array name="flap_phrase_fit">
        <item>Flap est à fond. Et il le sait.</item>
        <item>Flap pète la forme. Il encaisse tout.</item>
        <item>Flap a l’air de sortir tout juste de sa boîte.</item>
        <item>Flap a plus d’énergie que ta batterie au réveil.</item>
        <item>Flap saute partout comme s’il était invincible.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="flap_phrase_normal">
        <item>Flap fait aller.</item>
        <item>Flap va bien. Sans plus.</item>
        <item>Flap tient le coup.</item>
        <item>Flap est toujours debout. Sans chichis.</item>
        <item>Flap est normal. C’est déjà ça.</item>
    </string-array>
    <!-- Frase de Flap cansado (cerca de su aguante). -->
    <string-array name="flap_phrase_tired">
        <item>Flap a des cernes.</item>
        <item>Flap bâille entre deux vidéos.</item>
        <item>Flap demande une pause. Une petite suffira.</item>
        <item>Flap est à bout de forces.</item>
        <item>Flap ne saute plus. Il marche.</item>
    </string-array>
    <!-- Frase de Flap enfermo (ha pasado su aguante). Sin culpa: mañana se le pasa. -->
    <string-array name="flap_phrase_sick">
        <item>Flap a la fièvre du scroll.</item>
        <item>Flap a pris sa température. Le chiffre ne lui plaît pas.</item>
        <item>Flap grelotte. Chaque vidéo passe plus mal.</item>
        <item>Flap est patraque. Demain, ça ira mieux.</item>
        <item>Flap réclame une soupe et une couverture.</item>
    </string-array>
    <!-- Frase de Flap KO (el doble de su aguante). Sin dramas. Debajo de la barra ya pone «KO hasta mañana. A medianoche revive.»:
         que la frase no repita cuándo revive ni vuelva a decir «KO». -->
    <string-array name="flap_phrase_ko">
        <item>Flap est tombé raide.</item>
        <item>Flap est au tapis. Même une soupe n’y changerait rien.</item>
        <item>Flap s’est effondré. Il ne cligne même plus des yeux.</item>
        <item>Flap n’en peut plus. Il reste par terre.</item>
    </string-array>
    <!-- Frase de Flap recién llegado (la app aún no ha contado ningún vídeo). -->
    <string-array name="flap_phrase_fresh">
        <item>Flap vient d’arriver et il est à fond.</item>
        <item>Flap commence avec toute la vie devant lui.</item>
        <item>Flap est tout neuf. Il n’a pas encore vu une seule vidéo.</item>
        <item>Flap t’attend en pleine forme. Reste à voir combien de temps.</item>
    </string-array>
    <!-- Frase cuando Flap ha mejorado desde la última vez que lo viste: por un día nuevo o por un objetivo más alto (también
         a media tarde). Que no hable del día, de ayer ni de que estaba caído. Sale con cualquier mejora, también de KO a
         ENFERMO o de ENFERMO a CANSADO (al subir el objetivo o en un día nuevo con muchos vídeos ya vistos): que no dé por
         hecho que ya está bien. -->
    <string-array name="flap_phrase_recovered">
        <item>Flap reprend des couleurs.</item>
        <item>Flap est en meilleur état que la dernière fois que tu l’as vu.</item>
        <item>Flap respire un peu mieux qu’avant.</item>
        <item>Flap est de retour et dit qu’il va mieux.</item>
    </string-array>

    <!-- TalkBack: Flap. %1$s el estado en minúsculas («enfermo»), %2$s la vida («32») y %3$s el máximo («100»).
         La frase de Flap se lee aparte. -->
    <string name="flap_description">Flap\u00A0: %1$s, vie %2$s sur %3$s.</string>
    <!-- Acción de tocar a Flap (TalkBack: «toca dos veces para saludar a Flap»). -->
    <string name="flap_tap">saluer Flap</string>

    <!-- ============================================================ vida -->

    <!-- Etiqueta de la barra de vida, en MAYÚSCULAS. -->
    <string name="flap_life">VIE</string>
    <!-- TalkBack de la barra de vida: «Vida: 62 de 100». -->
    <string name="flap_life_description">Vie\u00A0: %1$s sur %2$s</string>
    <!-- «HOY 31 VÍDEOS · AGUANTA 40»: %1$s los vídeos de hoy (la forma va según ellos), %2$s su aguante
         (el objetivo o, sin objetivo, 150). Se pasa a mayúsculas sola. -->
    <plurals name="flap_today_line">
        <item quantity="one">Aujourd’hui %1$s\u00A0vidéo · encaisse %2$s</item>
        <item quantity="many">Aujourd’hui %1$s\u00A0vidéos · encaisse %2$s</item>
        <item quantity="other">Aujourd’hui %1$s\u00A0vidéos · encaisse %2$s</item>
    </plurals>
    <!-- Lo que falta para el siguiente estado, peor. %1$s los vídeos que faltan (la forma va según ellos). -->
    <plurals name="flap_next_normal">
        <item quantity="one">Encore %1$s\u00A0vidéo et il ne sera plus en forme.</item>
        <item quantity="many">Encore %1$s\u00A0vidéos et il ne sera plus en forme.</item>
        <item quantity="other">Encore %1$s\u00A0vidéos et il ne sera plus en forme.</item>
    </plurals>
    <plurals name="flap_next_tired">
        <item quantity="one">Encore %1$s\u00A0vidéo et il sera fatigué.</item>
        <item quantity="many">Encore %1$s\u00A0vidéos et il sera fatigué.</item>
        <item quantity="other">Encore %1$s\u00A0vidéos et il sera fatigué.</item>
    </plurals>
    <plurals name="flap_next_sick">
        <item quantity="one">Encore %1$s\u00A0vidéo et il tombera malade.</item>
        <item quantity="many">Encore %1$s\u00A0vidéos et il tombera malade.</item>
        <item quantity="other">Encore %1$s\u00A0vidéos et il tombera malade.</item>
    </plurals>
    <plurals name="flap_next_ko">
        <item quantity="one">Encore %1$s\u00A0vidéo et il sera KO.</item>
        <item quantity="many">Encore %1$s\u00A0vidéos et il sera KO.</item>
        <item quantity="other">Encore %1$s\u00A0vidéos et il sera KO.</item>
    </plurals>
    <!-- Ya está KO: no hay nada peor. -->
    <string name="flap_ko_until_tomorrow">KO jusqu’à demain. Il revient à minuit.</string>

    <!-- ============================================================ cómo funciona -->

    <!-- Cabecera de sección, en MAYÚSCULAS. -->
    <string name="flap_section_how">COMMENT ÇA MARCHE</string>
    <!-- %1$s la vida máxima («100»). -->
    <string name="flap_how_start">Chaque jour, Flap démarre à fond, avec %1$s de vie. À minuit, il revient.</string>
    <string name="flap_how_video">Chaque vidéo que tu regardes lui enlève un peu de vie.</string>
    <!-- Con objetivo: %1$s el objetivo (la forma va según él), %2$s el doble. -->
    <plurals name="flap_how_goal">
        <item quantity="one">À ton objectif (%1$s\u00A0vidéo), il finit la journée à mi-vie\u00A0; au double (%2$s), il est KO.</item>
        <item quantity="many">À ton objectif (%1$s\u00A0vidéos), il finit la journée à mi-vie\u00A0; au double (%2$s), il est KO.</item>
        <item quantity="other">À ton objectif (%1$s\u00A0vidéos), il finit la journée à mi-vie\u00A0; au double (%2$s), il est KO.</item>
    </plurals>
    <!-- Sin objetivo: %1$s el aguante (150; la forma va según él), %2$s el doble. -->
    <plurals name="flap_how_default">
        <item quantity="one">À %1$s\u00A0vidéo, il finit la journée à mi-vie\u00A0; au double (%2$s), il est KO.</item>
        <item quantity="many">À %1$s\u00A0vidéos, il finit la journée à mi-vie\u00A0; au double (%2$s), il est KO.</item>
        <item quantity="other">À %1$s\u00A0vidéos, il finit la journée à mi-vie\u00A0; au double (%2$s), il est KO.</item>
    </plurals>
    <!-- Sin objetivo, junto al botón PONER OBJETIVO. %1$s el aguante (150; la forma va según él). -->
    <plurals name="flap_no_goal">
        <item quantity="one">Sans objectif, Flap encaisse %1$s\u00A0vidéo par jour. Avec le tien, il tient ce que tu décides.</item>
        <item quantity="many">Sans objectif, Flap encaisse %1$s\u00A0vidéos par jour. Avec le tien, il tient ce que tu décides.</item>
        <item quantity="other">Sans objectif, Flap encaisse %1$s\u00A0vidéos par jour. Avec le tien, il tient ce que tu décides.</item>
    </plurals>
    <!-- TalkBack del botón PONER OBJETIVO. -->
    <string name="flap_set_goal_description">Définir un objectif quotidien dans Réglages</string>

    <!-- ============================================================ la semana -->

    <!-- Cabecera de sección, en MAYÚSCULAS. -->
    <string name="flap_section_week">LA SEMAINE</string>
    <!-- TalkBack de un día: «Martes 3 de noviembre: 34 vídeos, cansado.». %1$s el día, %2$s los vídeos
         («34 vídeos»), %3$s el estado en minúsculas. -->
    <string name="flap_day_description">%1$s\u00A0: %2$s, %3$s.</string>
    <!-- TalkBack de un día anterior a los primeros vídeos contados. %1$s el día. -->
    <string name="flap_day_description_none">%1$s\u00A0: pas de données.</string>
    <!-- Etiqueta de la racha, en MAYÚSCULAS. -->
    <string name="flap_streak_label">SÉRIE</string>
    <!-- Días cerrados seguidos sin pasar del aguante. %1$s los días (la forma va según ellos). -->
    <plurals name="flap_streak">
        <item quantity="one">%1$s\u00A0jour d’affilée sans tomber malade</item>
        <item quantity="many">%1$s\u00A0jours d’affilée sans tomber malade</item>
        <item quantity="other">%1$s\u00A0jours d’affilée sans tomber malade</item>
    </plurals>
</resources>
