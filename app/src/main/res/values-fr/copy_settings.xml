    <string name="settings_quick_send_empty_app">Il n’y a encore personne à épingler sur %1$s. Partage une vidéo à la main sur %1$s avec «\u00A0À qui tu envoies\u00A0» activé\u00A0: les personnes et les groupes à qui tu envoies apparaîtront ici.</string>
    <!-- Encima de la lista de personas y grupos para fijar. %1$s el nombre de la app. -->
    <string name="settings_quick_send_list_label_app">Ceux à qui tu envoies le plus sur %1$s</string>
    <!-- Bajo RECOLOCAR y tras pulsarlo. %1$s el nombre de la app. -->
    <string name="settings_quick_send_relocate_hint_app">Sur %1$s, les bulles reviennent à leur place, au bord droit.</string>
    <string name="settings_quick_send_relocated_app">C’est fait. Tu les verras à leur place dans la prochaine vidéo %1$s.</string>

