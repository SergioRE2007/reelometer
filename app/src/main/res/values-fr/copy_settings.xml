    <!-- ============================================================ 07 privacidad -->

    <!-- Explicación de privacidad: un párrafo corto por <item>, en este orden. -->
    <string-array name="settings_privacy_paragraphs">
        <item>Reelometer compte ce que tu vois sur TikTok, Instagram et YouTube grâce au service d’accessibilité d’Android. Pour chaque vidéo, l’application enregistre l’app, l’heure, combien de temps tu l’as regardée, le créateur et la description.</item>
        <item>Tout est enregistré dans ce téléphone. Pas de comptes, de serveurs, de publicités ni d’analyses. L’application n’a pas l’autorisation d’utiliser internet.</item>
        <item>Tes données ne sortent d’ici que si tu le décides\u00A0: en exportant le CSV ou en partageant ton ticket.</item>
        <item>Si tu désactives le service, je ne compte plus. Si tu effaces les données ou désinstalles l’application, elles disparaissent.</item>
    </string-array>
    <!-- Enlace en MAYÚSCULAS. Abre la política en el navegador: en español si los textos están en español; en inglés con cualquier otro idioma. -->
