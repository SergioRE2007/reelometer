<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de Ajustes (copy/SettingsCopy.kt): una lista editorial de 8 secciones numeradas
  («01  OBJETIVO ─────» + descripción). Habla la app en primera persona («te aviso», «cuento»).
  Los textos en MAYÚSCULAS se ven así en pantalla (etiquetas y botones): escríbelos en mayúsculas.
  Los botones y etiquetas tienen poco sitio: mejor cortos.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <!-- Título de la pantalla (barra de arriba). -->
    <string name="settings_title">Réglages</string>

    <!-- Secciones: título en MAYÚSCULAS (cabecera numerada, poco sitio) y descripción bajo él. -->
    <string name="settings_section_goal_title">OBJECTIF</string>
    <string name="settings_section_goal_description">Un maximum de vidéos par jour. Sert au «\u00A0il te reste\u00A0» d’Aujourd’hui et aux séries.</string>
    <string name="settings_section_notifications_title">ALERTES</string>
    <string name="settings_section_notifications_description">Un bilan par jour, à l’heure que tu choisis, et un autre chaque mois.</string>
    <string name="settings_section_apps_title">APPS COMPTÉES</string>
    <string name="settings_section_apps_description">Ce que tu désactives ici cesse d’être compté tout de suite. Ce qui est déjà compté reste.</string>
    <!-- Sección del tema (claro, oscuro o el del sistema); también lleva la fila del idioma. -->
    <string name="settings_section_theme_title">THÈME</string>
    <string name="settings_section_theme_description">Le compteur a plus d’allure dans le noir, mais c’est toi qui décides.</string>
    <string name="settings_section_data_title">TES DONNÉES</string>
    <string name="settings_section_data_description">Tout ce qui est compté vit dans ce téléphone. Tu peux l’emporter, le récupérer ou l’effacer.</string>
    <string name="settings_section_service_title">SERVICE</string>
    <string name="settings_section_service_description">L’autorisation d’accessibilité, c’est ce qui me permet de compter. Ici tu vois si elle est active.</string>
    <string name="settings_section_privacy_title">CONFIDENTIALITÉ</string>
    <string name="settings_section_privacy_description">Ce qui arrive à tes données, sans petits caractères.</string>
    <string name="settings_section_about_title">À PROPOS</string>
    <string name="settings_section_about_description">Reelometer n’a aucun lien avec TikTok, Instagram ou YouTube. Il compte seulement ce que tu y vois.</string>

    <!-- Antetítulo de los diálogos que salen de una sección: «05 · TUS DATOS». %1$s el número de la
         sección («05»), %2$s su título (ya en MAYÚSCULAS). -->
    <string name="settings_dialog_kicker">%1$s · %2$s</string>

    <!-- Índice de arriba: un acceso por sección que salta a ella. Nombres cortos (se ven en MAYÚSCULAS,
         en media fila y con el número delante): cuanto más cortos, mejor. -->
    <string name="settings_index_goal">Objectif</string>
    <string name="settings_index_notifications">Alertes</string>
    <string name="settings_index_apps">Apps</string>
    <string name="settings_index_theme">Thème</string>
    <string name="settings_index_data">Tes données</string>
    <string name="settings_index_service">Service</string>
    <string name="settings_index_privacy">Confidentialité</string>
    <string name="settings_index_about">À propos</string>
    <!-- TalkBack de cada acceso del índice. %1$s el nombre corto de la sección («Tus datos»). -->
    <string name="settings_index_go">Aller à %1$s</string>
    <!-- TalkBack: el acceso de la sección donde estabas antes de volver al índice. -->
    <string name="settings_index_here">Tu étais ici</string>
    <!-- Barra fija de arriba al bajar por la lista: botón para volver al índice (MAYÚSCULAS, muy corto). -->
    <string name="settings_index_back">SOMMAIRE</string>
    <!-- TalkBack del botón ÍNDICE. -->
    <string name="settings_index_back_description">Revenir au sommaire des réglages</string>

    <!-- Línea plegable del envío rápido (se ve en MAYÚSCULAS): apagado, encendido sin nadie fijado y con
         %1$s fijados (la cifra ya formateada). -->
    <string name="settings_quick_send_fold_off">Envoi rapide · désactivé</string>
    <string name="settings_quick_send_fold_none">Envoi rapide · personne d’épinglé</string>
    <plurals name="settings_quick_send_fold">
        <item quantity="one">Envoi rapide · %1$s épinglé</item>
        <item quantity="many">Envoi rapide · %1$s épinglés</item>
        <item quantity="other">Envoi rapide · %1$s épinglés</item>
    </plurals>
    <!-- Línea plegable del final (se ve en MAYÚSCULAS): licencias, calibración y depuración. -->
    <string name="settings_tools_fold">Licences et outils</string>
    <!-- TalkBack de las líneas plegables: su estado y qué hace tocarlas («toca dos veces para desplegar»). -->
    <string name="settings_fold_open">Développé</string>
    <string name="settings_fold_closed">Réduit</string>
    <string name="settings_fold_expand">développer</string>
    <string name="settings_fold_collapse">réduire</string>

    <!-- ============================================================ 01 objetivo -->

    <!-- Valor a la derecha de la línea del objetivo, en MAYÚSCULAS: «150 AL DÍA». %1$s el objetivo («150»). -->
    <string name="settings_goal_value">%1$s PAR JOUR</string>
    <!-- Línea del selector: «Vídeos al día ······ [ − 150 + ]». -->
    <string name="settings_goal_line">Vidéos par jour</string>
    <!-- Interruptor de Flap, la mascota que empieza cada día a tope y empeora con cada vídeo («Flap» es nombre
         propio, no se traduce): su pestaña y Flap en el widget grande. -->
    <string name="settings_passport_label">Flap, la mascotte</string>
    <string name="settings_passport_description">Un onglet avec Flap\u00A0: chaque jour, il commence en pleine forme et va de plus en plus mal à chaque vidéo regardée, puis il revit à minuit. Il apparaît aussi sur le grand widget. Si tu le désactives, il disparaît des deux.</string>

    <!-- ============================================================ 02 avisos -->

    <string name="settings_daily_label">Bilan quotidien</string>
    <!-- Bajo el resumen diario: «Tu cuenta del día, a las 21:30.». %1$s la hora con su preposición («a las 21:30»). -->
    <string name="settings_daily_description">Ton décompte du jour, %1$s.</string>
    <!-- Línea que abre el selector de hora (a la derecha va la hora, «21:30»). -->
    <string name="settings_time_label">Heure de l’alerte</string>
    <string name="settings_monthly_label">Bilan mensuel</string>
    <string name="settings_monthly_description">Le 1er, le mois précédent compté, avec son bilan.</string>
    <!-- Aviso en directo al pasar el objetivo (apagado por defecto). -->
    <string name="settings_goal_live_label">Alerte d’objectif</string>
    <!-- %1$s el objetivo con su palabra («150 vídeos»). -->
    <string name="settings_goal_live_description">Une seule alerte par jour, dès que tu dépasses %1$s.</string>
    <!-- Lo mismo sin objetivo: explica por qué no se puede encender. -->
    <string name="settings_goal_live_needs_goal">Il faut un objectif. Mets-en un et je te préviens dès que tu le dépasses.</string>

    <!-- Selector de la hora del aviso (una hoja). HORA y MINUTOS son etiquetas en MAYÚSCULAS sobre cada rueda. -->
    <string name="settings_time_dialog_title">À quelle heure je te préviens\u00A0?</string>
    <string name="settings_time_hour">HEURE</string>
    <string name="settings_time_minute">MINUTES</string>
    <!-- TalkBack: botones de las ruedas (las horas van de una en una y los minutos, de cinco en cinco). -->
    <string name="settings_time_hour_down">Une heure de moins</string>
    <string name="settings_time_hour_up">Une heure de plus</string>
    <string name="settings_time_minute_down">Cinq minutes de moins</string>
    <string name="settings_time_minute_up">Cinq minutes de plus</string>

    <!-- Con los avisos bloqueados en Android (va con el botón ABRIR AJUSTES). -->
    <string name="settings_notifications_blocked">Android a désactivé les alertes de Reelometer. Active-les dans les paramètres du système pour les recevoir.</string>

    <!-- ============================================================ 03 apps -->

    <!-- Con todas las apps apagadas. -->
    <string name="settings_all_apps_off">Tu les as toutes éteintes. Du coup, plus rien à compter.</string>

    <!-- Interruptor «A quién envías» (Instagram y TikTok). «Estadísticas» es la pestaña de la app. -->
    <string name="settings_recipients_label">À qui tu envoies</string>
    <string name="settings_recipients_description">Sur Instagram et TikTok. Quand tu partages une vidéo, je note le nom de la personne ou du groupe que tu choisis, et dans Statistiques tu vois à qui tu envoies le plus. Je ne lis ni le chat ni ce que tu écris, et tout reste dans ce téléphone.</string>

    <!-- Interruptor «Envío rápido» (Instagram y TikTok): unas burbujas sobre los vídeos que los comparten
         con un toque. «Compartir» y «Enviar» citan los botones de Instagram y TikTok tal cual: en cada idioma,
         como los muestren esas apps en ese idioma. «X» es la zona donde se sueltan las burbujas. -->
    <string name="settings_quick_send_label">Envoi rapide</string>
    <string name="settings_quick_send_description">Sur Instagram et TikTok. Pendant que tu regardes des vidéos, une bulle apparaît pour chaque personne ou groupe que tu épingles dans cette application. En la touchant, j’appuie pour toi sur «\u00A0Partager\u00A0», sur ce nom, puis sur «\u00A0Envoyer\u00A0»\u00A0; s’il n’apparaît pas, je le cherche dans la barre de recherche de la feuille (sur TikTok, en touchant d’abord sa loupe). Rien de plus. Si quelque chose ne colle pas, je m’arrête et tu termines. Pour afficher sa photo dans la bulle, je la découpe dans la feuille de partage quand elle est visible, ou tu choisis une photo de ta galerie\u00A0; elle reste dans ce téléphone. Fais-les glisser où tu veux (en bas, au-dessus du nom de la vidéo, elles se mettent en file) ou lâche-les sur la «\u00A0X\u00A0» pour les masquer jusqu’à la vidéo suivante.</string>
    <!-- El gesto para enviar a dos personas a la vez. -->
    <string name="settings_quick_send_pair_hint">Pour l’envoyer à deux personnes à la fois, maintiens une bulle jusqu’à ce qu’elle se détache et lâche-la sur l’autre. Si tu en touches une autre pendant l’envoi, je l’ajoute à la même feuille.</string>
    <!-- Con «A quién envías» apagado, el envío rápido no se puede encender. -->
    <string name="settings_quick_send_needs_recipients">Pour l’utiliser, active d’abord «\u00A0À qui tu envoies\u00A0»\u00A0: l’envoi rapide cherche dans la feuille le nom que tu épingles.</string>
    <!-- Botones de cada fila, en MAYÚSCULAS y con poco sitio: fijar a alguien / ya fijado. -->
    <string name="settings_quick_send_pin">ÉPINGLER</string>
    <string name="settings_quick_send_pinned">ÉPINGLÉ</string>
    <!-- Botón en MAYÚSCULAS: devuelve las burbujas de esa app a su sitio por defecto (borde derecho;
         la altura depende de la app, ver BubbleLayout.defaultFor). -->
    <string name="settings_quick_send_relocate">REPLACER</string>
    <!-- Ya hay el máximo de fijados. %1$s el máximo («3»). -->
    <plurals name="settings_quick_send_full">
        <item quantity="one">Tu as déjà %1$s épinglé. Retire-le pour en épingler un autre.</item>
        <item quantity="many">Tu as déjà %1$s épinglés. Retire-en un pour en épingler un autre.</item>
        <item quantity="other">Tu as déjà %1$s épinglés. Retire-en un pour en épingler un autre.</item>
    </plurals>
    <!-- TalkBack, en cada fila. %1$s el nombre de la persona o el grupo. -->
    <string name="settings_quick_send_pin_description">Épingler %1$s dans l’envoi rapide</string>
    <string name="settings_quick_send_unpin_description">Retirer %1$s de l’envoi rapide</string>
    <!-- Botones en MAYÚSCULAS bajo cada fijado: elegir de la galería la foto de su burbuja, cambiarla o quitarla. -->
    <string name="settings_quick_send_photo_pick">CHOISIR UNE PHOTO</string>
    <string name="settings_quick_send_photo_change">CHANGER</string>
    <string name="settings_quick_send_photo_clear">RETIRER</string>
    <string name="settings_quick_send_photo_set">Photo ajoutée. Tu la verras dans sa bulle\u00A0; elle reste uniquement dans ce téléphone.</string>
    <string name="settings_quick_send_photo_cleared">Photo retirée. La photo automatique revient ou, à défaut, les initiales.</string>
    <string name="settings_quick_send_photo_failed">Je n’ai pas pu ouvrir cette photo. Essaie-en une autre.</string>
    <!-- TalkBack de esos botones. %1$s el nombre de la persona o el grupo. -->
    <string name="settings_quick_send_photo_pick_description">Choisir dans la galerie la photo de la bulle de %1$s</string>
    <string name="settings_quick_send_photo_change_description">Remplacer la photo de la bulle de %1$s par une autre de la galerie</string>
    <string name="settings_quick_send_photo_clear_description">Retirer la photo choisie pour %1$s et revenir à l’automatique</string>

    <!-- 1.10.0, envío rápido en Instagram y en TikTok: cada app tiene sus fijados y su sitio para las burbujas.
         Va encima de las dos pestañas con el nombre de cada app (INSTAGRAM, TIKTOK: las marcas no se traducen). -->
    <string name="settings_quick_send_apps_hint">Chaque application a ses épinglés et sa place pour les bulles\u00A0: tes contacts TikTok ne sont pas ceux d’Instagram.</string>
    <!-- TalkBack de cada pestaña. %1$s el nombre de la app («TikTok», «Instagram»). -->
    <string name="settings_quick_send_app_description">Voir tes épinglés sur %1$s</string>
