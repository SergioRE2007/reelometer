    <string name="passport_flap_description_warming">Flap, ta mascotte du passeport\u00A0: en chauffe. %1$s</string>
    <!-- TalkBack, acción al tocar a Flap: «toca dos veces para saludar a Flap». Empieza en minúscula. -->
    <string name="passport_flap_tap">saluer Flap</string>

