        <item quantity="one">%1$s sur %2$s\u00A0jour sous ton objectif</item>
        <item quantity="many">%1$s sur %2$s\u00A0jours sous ton objectif</item>
        <item quantity="other">%1$s sur %2$s\u00A0jours sous ton objectif</item>
    </plurals>
    <!-- Igual sin objetivo: la referencia es la media del usuario. -->
    <plurals name="passport_record_average">
        <item quantity="one">%1$s sur %2$s\u00A0jour sous ta moyenne</item>
        <item quantity="many">%1$s sur %2$s\u00A0jours sous ta moyenne</item>
        <item quantity="other">%1$s sur %2$s\u00A0jours sous ta moyenne</item>
    </plurals>
    <!-- «TU OBJETIVO: 150 AL DÍA» / «TU MEDIA: 140 AL DÍA». %1$s vídeos al día. Se pasa a mayúsculas sola. -->
    <string name="passport_reference_goal">ton objectif\u00A0: %1$s par jour</string>
    <string name="passport_reference_average">ta moyenne\u00A0: %1$s par jour</string>

    <!-- TalkBack: Flap entero. %1$s el estado en minúsculas («cansado»), %2$s el registro como frase
         («5 de 7 días bajo tu objetivo.»), %3$s la frase de Flap. -->
    <string name="passport_flap_description">Flap, ta mascotte du passeport\u00A0: %1$s. %2$s %3$s</string>
