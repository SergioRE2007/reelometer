<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo Pasaporte (copy/PassportCopy.kt): pestaña con Flap (la mascota), la tarjeta de embarque
  (niveles y millas), los sellos, el reto semanal contra «tu fantasma» (tú la semana pasada), las
  celebraciones y el ticket de nivel que se comparte como imagen.
  Tono: aeropuerto, tarjeta de embarque, ironía amable. Premia ver menos y nunca culpa.
  Las millas salen de ver MENOS vídeos (días bajo la referencia, rachas, retos y sellos), nunca de verlos.
  Nombres propios: «Flap» (la mascota) y «Reelometer» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2).  es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña y nombre del modo (palabra normal: tradúcela). -->
    <string name="passport_title">Passeport</string>

    <!-- Cabeceras de sección, en MAYÚSCULAS. «FLAP» es el nombre de la mascota (no se traduce). -->
    <string name="passport_section_flap">FLAP</string>
    <string name="passport_section_level">CARTE D’EMBARQUEMENT</string>
    <string name="passport_section_challenge">DÉFI DE LA SEMAINE</string>
    <string name="passport_section_stamps">TAMPONS</string>
    <string name="passport_section_past">DÉFIS PRÉCÉDENTS</string>

    <!-- Kicker de la cabecera: «63 DÍAS A BORDO». %1$s son los días («63 días»). Se pasa a mayúsculas sola. -->
    <string name="passport_on_board">%1$s à bord</string>

    <!-- ============================================================ Flap (la mascota) -->

    <!-- Estado de Flap, en MAYÚSCULAS y corto (etiqueta junto al dibujo). En TalkBack se lee en minúsculas. -->
    <string name="passport_mood_fit">EN FORME</string>
    <string name="passport_mood_normal">NORMAL</string>
    <string name="passport_mood_tired">FATIGUÉ</string>
    <string name="passport_mood_zombie">ZOMBIE DU SCROLL</string>
    <!-- Estado mientras Flap no tiene con qué comparar (ni objetivo ni historial). MAYÚSCULAS. -->
    <string name="passport_warming_up">EN CHAUFFE</string>

    <!-- Frase de Flap en forma (la semana va bien). -->
    <string-array name="passport_phrase_fit">
        <item>Flap a de la marge cette semaine.</item>
        <item>Flap est en pleine forme. Toi aussi, même si ça ne se voit pas.</item>
        <item>Flap a oublié ce qu’était le scroll.</item>
        <item>Flap regarde de nouveau par le hublot.</item>
        <item>Flap s’est inscrit à la course. Pour l’instant, ça va.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="passport_phrase_normal">
        <item>Flap tient le coup.</item>
        <item>Flap, ni figue ni raisin.</item>
        <item>Flap encaisse sans broncher.</item>
        <item>Flap est comme ta semaine\u00A0: normal.</item>
        <item>Flap ni bien ni mal. Flap, tout court.</item>
    </string-array>
    <!-- Frase de Flap cansado (la semana va regular). -->
    <string-array name="passport_phrase_tired">
        <item>Flap a les cernes.</item>
        <item>Flap a peu dormi, ça se voit.</item>
        <item>Flap demande une pause. Une journée calme lui suffit.</item>
        <item>Flap bâille entre deux vidéos.</item>
        <item>Flap est fatigué, mais il ne lâche rien.</item>
    </string-array>
    <!-- Frase de Flap zombi (mucho scroll). Sin culpa: siempre se puede recuperar. -->
    <string-array name="passport_phrase_zombie">
        <item>Flap marche les bras tendus devant lui.</item>
        <item>Flap ne sait plus dire que «\u00A0encore une\u00A0».</item>
        <item>Flap est un zombie du scroll. Une journée calme le soigne.</item>
        <item>Flap ne meurt pas. Il traverse juste une mauvaise passe.</item>
        <item>Flap se rétablira dès que tu tiendras une journée.</item>
    </string-array>
    <!-- Frase mientras Flap calienta (sin objetivo ni historial suficiente). -->
    <string-array name="passport_phrase_warming">
        <item>Flap apprend encore à te connaître. Donne-lui quelques jours.</item>
        <item>Sans objectif ni historique, Flap ne juge pas. Pas encore.</item>
        <item>Flap s’échauffe. Dans quelques jours, il te dira quelque chose.</item>
        <item>Premiers jours\u00A0: Flap observe et prend des notes.</item>
    </string-array>
    <!-- Frase cuando Flap vuelve de zombi a normal o mejor. -->
    <string-array name="passport_phrase_recovered">
        <item>Flap est revenu du monde des scrolls.</item>
        <item>Ni zombie ni rien\u00A0: Flap s’est rétabli.</item>
        <item>Flap cligne de nouveau des yeux normalement.</item>
        <item>Flap est de retour. Il dit ne se souvenir de rien.</item>
    </string-array>

    <!-- Registro de la semana bajo Flap, en MAYÚSCULAS (sin días contados esta semana). -->
    <string name="passport_record_none">AUCUN ENREGISTREMENT CETTE SEMAINE</string>
    <!-- «5 DE 7 DÍAS BAJO TU OBJETIVO»: %1$s días bajo el objetivo, %2$s días contados (la forma va
