<?xml version="1.0" encoding="utf-8"?>
<!--
  Detalle de un día (copy/DayCopy.kt): se abre al tocar el marcador o una barra del calendario.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). Los arrays con sufijo (_one, _notime, _noeq) son la
  misma situación en otro caso gramatical: mantén el mismo sentido en cada posición.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <!-- Título en frase. %1$s es la fecha larga («martes 3 de noviembre»). -->
    <string name="day_title_today">Aujourd’hui, %1$s</string>
    <string name="day_title_yesterday">Hier, %1$s</string>

    <!-- Etiqueta en MAYÚSCULAS (se pasa a mayúsculas sola): «MARTES 3 NOV». %1$s día de la semana,
         %2$s fecha corta («3 nov» o «3 nov 2025»). -->
    <string name="day_label_date">%1$s %2$s</string>
    <!-- «HOY · MARTES 3 NOV»: %1$s es la etiqueta de arriba, ya en mayúsculas. -->
    <string name="day_label_today">AUJ. · %1$s</string>
    <string name="day_label_yesterday">HIER · %1$s</string>

    <!-- Frase de un día pasado, cero vídeos. -->
    <string-array name="day_zero">
        <item>Ce jour-là, pas une seule vidéo.</item>
        <item>Zéro. Une bonne journée, ou alors sans réseau.</item>
        <item>Rien ce jour-là. Soit tu n’as rien vu, soit je ne regardais pas.</item>
    </string-array>

    <!-- Con objetivo, pasado: %1$s lo que se pasó («62 vídeos»), %2$s el objetivo, %3$s los vídeos del día. -->
    <string-array name="day_goal_over">
        <item>Ce jour-là, tu as dépassé de %1$s.</item>
        <item>Objectif\u00A0: %2$s. Ce jour-là\u00A0: %3$s.</item>
        <item>%1$s au-dessus de l’objectif. Ça arrive.</item>
    </string-array>
    <!-- Con objetivo, justo en el límite: %1$s el objetivo. -->
    <string-array name="day_goal_at">
        <item>Pile sur la limite\u00A0: %1$s, pas une de plus.</item>
        <item>%1$s sur %1$s. Net.</item>
        <item>Objectif atteint pile ce jour-là.</item>
    </string-array>
    <!-- Con objetivo, por debajo: %1$s los vídeos del día, %2$s el objetivo, %3$s el margen («38 vídeos»). -->
    <string-array name="day_goal_under">
        <item>Dans l’objectif\u00A0: %1$s sur %2$s.</item>
        <item>Sous %2$s, avec %3$s de marge.</item>
        <item>%1$s sur %2$s. Journée dans les limites.</item>
    </string-array>

    <!-- Día flojo (1–9 vídeos): %1$s los vídeos («3 vídeos»), %2$s el tiempo («2 minutos»).
         _one: un solo vídeo. _notime: menos de un minuto (sin tiempo en la frase). -->
    <string-array name="day_first">
        <item>Ce jour-là, c’étaient %1$s. Presque rien.</item>
        <item>%1$s et %2$s. Une journée tranquille.</item>
        <item>Petit score\u00A0: %1$s.</item>
    </string-array>
    <string-array name="day_first_notime">
        <item>Ce jour-là, c’étaient %1$s. Presque rien.</item>
        <item>%1$s. Une journée tranquille.</item>
        <item>Petit score\u00A0: %1$s.</item>
    </string-array>
    <string-array name="day_first_one">
        <item>Ce jour-là, c’était %1$s. Presque rien.</item>
        <item>%1$s et %2$s. Une journée tranquille.</item>
        <item>Petit score\u00A0: %1$s.</item>
    </string-array>
    <string-array name="day_first_one_notime">
        <item>Ce jour-là, c’était %1$s. Presque rien.</item>
        <item>%1$s. Une journée tranquille.</item>
        <item>Petit score\u00A0: %1$s.</item>
    </string-array>

    <!-- Día normal: %1$s los vídeos, %2$s el tiempo («47 minutos»), %3$s el tiempo con mayúscula
         inicial (para empezar la frase con él). -->
    <string-array name="day_normal">
        <item>%1$s et %2$s. Une journée normale, et c’est déjà beaucoup dire.</item>
        <item>Ce jour-là\u00A0: %2$s de vidéos.</item>
        <item>%3$s. Ni chair ni poisson.</item>
    </string-array>

    <!-- Día alto: %1$s los vídeos, %2$s el tiempo con mayúscula inicial, %3$s el tiempo, %4$s una
         equivalencia en infinitivo («leer 14 libros»). _noeq: sin equivalencia (no uses %4$s).
         _one: el tiempo es singular («una hora y 40 minutos»). -->
    <string-array name="day_high">
        <item>%1$s. Ce jour-là, l’algorithme a fait des heures supplémentaires.</item>
        <item>%2$s de vidéos. Ça te suffisait pour %4$s.</item>
        <item>Ce jour-là, il t’est passé %3$s. Comme ça, sans façon.</item>
    </string-array>
    <string-array name="day_high_noeq">
        <item>%1$s. Ce jour-là, l’algorithme a fait des heures supplémentaires.</item>
        <item>%2$s de vidéos. Une longue journée.</item>
        <item>Ce jour-là, il t’est passé %3$s. Comme ça, sans façon.</item>
    </string-array>
    <string-array name="day_high_one">
        <item>%1$s. Ce jour-là, l’algorithme a fait des heures supplémentaires.</item>
        <item>%2$s de vidéos. Ça te suffisait pour %4$s.</item>
        <item>Ce jour-là, il t’est passé %3$s. Comme ça, sans façon.</item>
    </string-array>
    <string-array name="day_high_one_noeq">
        <item>%1$s. Ce jour-là, l’algorithme a fait des heures supplémentaires.</item>
        <item>%2$s de vidéos. Une longue journée.</item>
        <item>Ce jour-là, il t’est passé %3$s. Comme ça, sans façon.</item>
    </string-array>

    <!-- Día extremo: %1$s los vídeos, %2$s el tiempo con mayúscula inicial. -->
    <string-array name="day_extreme">
        <item>%1$s. Il y a des jours et des jours. Celui-ci, c’est de la deuxième division.</item>
        <item>%2$s. Si quelqu’un demande, tu avais des choses à faire.</item>
        <item>%1$s en une seule journée. Ce jour-là, c’est l’algorithme qui a gagné.</item>
    </string-array>

    <!-- Puesto del día entre todos los contados (MAYÚSCULAS). -->
    <string name="day_rank_record">TON RECORD\u00A0: LE JOUR AVEC LE PLUS DE VIDÉOS</string>
    <!-- %1$s el puesto, %2$s los días contados (siempre 2 o más). -->
    <plurals name="day_rank_line">
        <item quantity="one">N° %1$s SUR %2$s JOUR COMPTÉ</item>
        <item quantity="many">N° %1$s SUR %2$s DE JOURS COMPTÉS</item>
        <item quantity="other">N° %1$s SUR %2$s JOURS COMPTÉS</item>
    </plurals>

    <!-- Estado frente al objetivo de un día cerrado (MAYÚSCULAS, columna estrecha: corto). %1$s cifra. -->
    <string name="day_goal_status_over">+%1$s\u00A0DÉPASSÉ</string>
    <string name="day_goal_status_at">À LA LIMITE</string>
    <string name="day_goal_status_under">%1$s\u00A0SOUS LA LIMITE</string>

    <!-- Lo mismo para TalkBack: %1$s la diferencia («38 vídeos»), %2$s el objetivo. -->
    <string name="day_goal_status_over_description">%1$s au-dessus de l’objectif de %2$s</string>
    <!-- %1$s el objetivo. -->
    <string name="day_goal_status_at_description">Pile sur l’objectif de %1$s</string>
    <string name="day_goal_status_under_description">%1$s sous l’objectif de %2$s</string>

    <!-- Cabecera de la sección por horas de un día pasado (MAYÚSCULAS). -->
    <string name="day_section_hours">CE JOUR, HEURE PAR HEURE</string>
    <!-- «PRIMER VÍDEO 08:12 · ÚLTIMO 01:47»: %1$s hora del primero, %2$s del último. -->
    <string name="day_first_last">PREMIÈRE VIDÉO %1$s · DERNIÈRE %2$s</string>
</resources>
