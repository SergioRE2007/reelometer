    <string name="today_section_hours">TU DÍA, HORA A HORA</string>
    <string name="today_section_categories">LO QUE MÁS VES</string>
    <!-- Las cuentas que publican los vídeos que ves. -->
    <string name="today_section_creators">QUIÉN TE LO PONE</string>

    <!-- Secciones vacías (todavía no hay datos hoy). -->
