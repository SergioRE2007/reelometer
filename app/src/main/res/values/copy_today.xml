<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla Hoy (copy/TodayCopy.kt): el marcador de vídeos de hoy, la frase bajo él, el objetivo,
  la comparación con la media y las secciones de debajo. También las líneas de comparación
  compartidas con Estadísticas (today_delta_*, de copy/Classify.kt).
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). Los arrays con sufijo (_one, _notime, _noeq) son la
  misma situación en otro caso gramatical: mantén el mismo sentido en cada posición.
  Tono: seco, con humor, sin sermones. Lo que va en MAYÚSCULAS son etiquetas con poco sitio.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- Cabeceras de sección en MAYÚSCULAS (poco sitio, una línea). -->
