<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema de ventana. Claro (papel) aquí; el oscuro está en values-night/themes.xml.
        Compose pinta todo lo demás (ReelTheme): esto solo evita destellos al arrancar y deja
        las barras del sistema transparentes (la app dibuja de borde a borde).
    -->
    <style name="Theme.Reelometro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/reel_bg</item>
        <item name="android:colorBackground">@color/reel_bg</item>
        <item name="android:colorAccent">@color/brand_signal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <!--
        Splash (API SplashScreen; MainActivity llama a installSplashScreen()). Fondo del tema y
        la ficha del icono, que voltea de «en blanco» a «R» y enciende la luz de grabación.
        En API < 31 se ve la ficha ya asentada (el estado estático del drawable).
    -->
    <style name="Theme.Reelometro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/reel_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_flap</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Reelometro</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
