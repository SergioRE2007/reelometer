    <string name="button_delete_all">BORRAR TODO</string>
    <string name="button_export_csv">EXPORTAR CSV</string>
    <string name="button_import_csv">IMPORTAR CSV</string>
    <string name="button_import_add">AÑADIR</string>
    <string name="button_import_replace">SUSTITUIR TODO</string>
    <!-- Botón de confirmar en «¿Sustituir todo?»: corto, cabe junto al icono con la fuente al 130 %. -->
    <string name="button_import_replace_confirm">SUSTITUIR</string>
    <string name="button_see_summary">VER RESUMEN</string>
    <string name="button_see_permission">VER EL PERMISO</string>
    <string name="button_remove_goal">QUITAR OBJETIVO</string>
    <string name="button_set_goal">PONER OBJETIVO</string>
    <string name="button_done">HECHO</string>
    <string name="button_back">ATRÁS</string>
    <string name="button_copy">COPIAR</string>
    <!-- Comparte el registro técnico de calibración (pantalla oculta). -->
    <string name="button_share_log">COMPARTIR LOG</string>
    <string name="button_clear">LIMPIAR</string>

    <!-- TalkBack: qué hace cada icono o acción. Frase normal, sin punto final. -->
    <string name="a11y_settings">Ajustes</string>
    <!-- Pestañas de la barra inferior, en minúsculas para que TalkBack las lea bien. -->
    <string name="a11y_tab_today">Hoy</string>
    <string name="a11y_tab_stats">Estadísticas</string>
    <string name="a11y_tab_wrapped">Resumen</string>
    <string name="a11y_tab_passport">Flap</string>
    <string name="a11y_share_summary">Compartir resumen</string>
    <string name="a11y_save_image">Guardar imagen</string>
    <string name="a11y_back">Atrás</string>
    <string name="a11y_close">Cerrar</string>
    <string name="a11y_previous_period">Periodo anterior</string>
    <string name="a11y_next_period">Periodo siguiente</string>
