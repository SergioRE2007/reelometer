    <!-- Botones «−» y «+» de un selector numérico. -->
    <string name="a11y_decrease">Menos</string>
    <string name="a11y_increase">Más</string>
    <!-- Resumen en diapositivas: «Diapositiva 3 de 10». %1$s la actual, %2$s el total. -->
    <string name="a11y_slide">Diapositiva %1$s de %2$s</string>
    <string name="a11y_next_slide">Diapositiva siguiente</string>
    <string name="a11y_previous_slide">Diapositiva anterior</string>
    <string name="a11y_open_summary">Ver el resumen</string>
</resources>
