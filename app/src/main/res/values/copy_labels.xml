<?xml version="1.0" encoding="utf-8"?>
<!--
  Etiquetas, botones y descripciones para TalkBack que se usan en toda la app (copy/Labels.kt).
  label_* y button_* van en MAYÚSCULAS y con muy poco sitio (etiquetas pequeñas con tracking,
  botones, pestañas): escríbelas ya en mayúsculas y lo más cortas posible.
  a11y_* son descripciones habladas (TalkBack): frase normal, sin punto final.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- Etiquetas cortas en MAYÚSCULAS sobre cifras (marcador, estadísticas, resumen, ticket). Poco sitio. -->
    <string name="label_videos">VÍDEOS</string>
    <string name="label_video">VÍDEO</string>
    <string name="label_time">TIEMPO</string>
    <string name="label_today">HOY</string>
    <string name="label_yesterday">AYER</string>
    <string name="label_goal">OBJETIVO</string>
    <!-- El servicio de accesibilidad está desconectado (el marcador se queda en blanco). -->
    <string name="label_no_signal">SIN SEÑAL</string>
    <!-- La hora del día con más vídeos. -->
    <string name="label_peak_hour">HORA PUNTA</string>
    <string name="label_weak_day">DÍA DÉBIL</string>
    <string name="label_worst_day">PEOR DÍA</string>
    <!-- Racha: días seguidos cumpliendo el objetivo. -->
    <string name="label_streak">RACHA</string>
    <string name="label_current_streak">RACHA ACTUAL</string>
    <string name="label_best_streak">MEJOR RACHA</string>
    <!-- Tiempo medio que dura cada vídeo. -->
    <string name="label_per_video">POR VÍDEO</string>
    <!-- Vídeos compartidos con otras personas. -->
    <string name="label_shares">COMPARTIDOS</string>
    <string name="label_daily_average">MEDIA DIARIA</string>
    <string name="label_active_days">DÍAS ACTIVOS</string>
    <string name="label_first_video">PRIMER VÍDEO</string>
    <string name="label_last_video">ÚLTIMO VÍDEO</string>
    <!-- TikTok, Instagram Reels, YouTube Shorts. -->
    <string name="label_platforms">PLATAFORMAS</string>
    <string name="label_categories">CATEGORÍAS</string>
    <!-- Cuentas que publican los vídeos. -->
    <string name="label_creators">CREADORES</string>
    <string name="label_top_creator">CREADOR N.º 1</string>
    <string name="label_top_category">CATEGORÍA N.º 1</string>
    <!-- Encabeza las equivalencias («leer 14 libros») del tiempo pasado viendo vídeos. -->
    <string name="label_equivalences">CON ESE TIEMPO</string>
    <string name="label_since_start">DESDE EL PRINCIPIO</string>
    <!-- Estado del servicio de accesibilidad. -->
    <string name="label_connected">CONECTADO</string>
    <string name="label_disconnected">DESCONECTADO</string>
    <!-- Una app (TikTok, Instagram…) que no está en el móvil. -->
    <string name="label_not_installed">NO INSTALADA</string>
    <!-- Sello: la app no envía nada fuera del móvil. %1$s es «100 %» ya formateado. -->
    <string name="label_local_stamp">%1$s LOCAL</string>
    <!-- Periodos de las estadísticas (pestañas segmentadas, muy poco sitio). ALL = todo el historial. -->
    <string name="label_week">SEMANA</string>
    <string name="label_month">MES</string>
    <string name="label_year">AÑO</string>
    <string name="label_all">SIEMPRE</string>
    <!-- Interruptores (dentro del propio interruptor, muy poco sitio: 2–3 letras). -->
    <string name="label_yes">SÍ</string>
    <string name="label_no">NO</string>

    <!-- Pestañas de la barra inferior (MAYÚSCULAS, muy poco sitio). -->
    <string name="label_tab_today">HOY</string>
    <string name="label_tab_stats">ESTADÍSTICAS</string>
    <!-- Resumen del periodo en diapositivas, tipo «historias». -->
    <string name="label_tab_wrapped">RESUMEN</string>
    <!-- Flap: la mascota que empieza cada día a tope y empeora con cada vídeo (nombre propio: no se traduce). -->
    <string name="label_tab_passport">FLAP</string>

    <!-- Botones (MAYÚSCULAS, verbos directos, poco sitio). -->
    <string name="button_connect">CONECTAR</string>
    <string name="button_retry">REINTENTAR</string>
    <string name="button_share">COMPARTIR</string>
    <string name="button_save">GUARDAR</string>
    <string name="button_next">SIGUIENTE</string>
    <string name="button_start">EMPEZAR</string>
    <!-- Acepta el aviso de accesibilidad y abre los ajustes para activar el servicio. -->
    <string name="button_accept_and_enable">ACEPTAR Y ACTIVAR</string>
    <string name="button_not_now">AHORA NO</string>
    <string name="button_open_settings">ABRIR AJUSTES</string>
    <!-- Abre los ajustes de accesibilidad de Android. -->
    <string name="button_open_accessibility">ABRIR ACCESIBILIDAD</string>
    <!-- Abre la pantalla «Información de la app» de Android. -->
    <string name="button_open_app_info">ABRIR INFORMACIÓN DE LA APP</string>
