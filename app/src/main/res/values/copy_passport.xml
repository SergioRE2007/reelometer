    <string name="passport_reference_goal">tu objetivo: %1$s al día</string>
    <string name="passport_reference_average">tu media: %1$s al día</string>

    <!-- TalkBack: Flap entero. %1$s el estado en minúsculas («cansado»), %2$s el registro como frase
         («5 de 7 días bajo tu objetivo.»), %3$s la frase de Flap. -->
    <string name="passport_flap_description">Flap, tu mascota del pasaporte: %1$s. %2$s %3$s</string>
