    <string name="passport_flap_description_warming">Flap, tu mascota del pasaporte: calentando. %1$s</string>
    <!-- TalkBack, acción al tocar a Flap: «toca dos veces para saludar a Flap». Empieza en minúscula. -->
    <string name="passport_flap_tap">saludar a Flap</string>

