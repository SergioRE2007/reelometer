        <item quantity="many">%1$s de %2$s\u00A0días bajo tu objetivo</item>
        <item quantity="other">%1$s de %2$s\u00A0días bajo tu objetivo</item>
    </plurals>
    <!-- Igual sin objetivo: la referencia es la media del usuario. -->
    <plurals name="passport_record_average">
        <item quantity="one">%1$s de %2$s\u00A0día bajo tu media</item>
        <item quantity="many">%1$s de %2$s\u00A0días bajo tu media</item>
        <item quantity="other">%1$s de %2$s\u00A0días bajo tu media</item>
    </plurals>
