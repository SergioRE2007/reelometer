<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo Pasaporte (copy/PassportCopy.kt): pestaña con Flap (la mascota), la tarjeta de embarque
  (niveles y millas), los sellos, el reto semanal contra «tu fantasma» (tú la semana pasada), las
  celebraciones y el ticket de nivel que se comparte como imagen.
  Tono: aeropuerto, tarjeta de embarque, ironía amable. Premia ver menos y nunca culpa.
  Las millas salen de ver MENOS vídeos (días bajo la referencia, rachas, retos y sellos), nunca de verlos.
  Nombres propios: «Flap» (la mascota) y «Reelómetro» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña y nombre del modo (palabra normal: tradúcela). -->
    <string name="passport_title">Pasaporte</string>

    <!-- Cabeceras de sección, en MAYÚSCULAS. «FLAP» es el nombre de la mascota (no se traduce). -->
    <string name="passport_section_flap">FLAP</string>
    <string name="passport_section_level">TARJETA DE EMBARQUE</string>
    <string name="passport_section_challenge">RETO DE LA SEMANA</string>
    <string name="passport_section_stamps">SELLOS</string>
    <string name="passport_section_past">RETOS ANTERIORES</string>

    <!-- Kicker de la cabecera: «63 DÍAS A BORDO». %1$s son los días («63 días»). Se pasa a mayúsculas sola. -->
    <string name="passport_on_board">%1$s a bordo</string>

    <!-- ============================================================ Flap (la mascota) -->

    <!-- Estado de Flap, en MAYÚSCULAS y corto (etiqueta junto al dibujo). En TalkBack se lee en minúsculas. -->
    <string name="passport_mood_fit">EN FORMA</string>
    <string name="passport_mood_normal">NORMAL</string>
    <string name="passport_mood_tired">CANSADO</string>
    <string name="passport_mood_zombie">ZOMBI DEL SCROLL</string>
    <!-- Estado mientras Flap no tiene con qué comparar (ni objetivo ni historial). MAYÚSCULAS. -->
    <string name="passport_warming_up">CALENTANDO</string>

    <!-- Frase de Flap en forma (la semana va bien). -->
    <string-array name="passport_phrase_fit">
        <item>Flap va sobrado esta semana.</item>
        <item>Flap está en plena forma. Tú también, aunque no lo parezca.</item>
        <item>Flap ya ni se acuerda de lo que era el scroll.</item>
        <item>Flap ha vuelto a mirar por la ventanilla.</item>
        <item>Flap se ha apuntado a correr. De momento, va.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="passport_phrase_normal">
        <item>Flap va tirando.</item>
        <item>Flap, ni fu ni fa.</item>
        <item>Flap aguanta el tipo.</item>
        <item>Flap está como tu semana: normal.</item>
        <item>Flap ni bien ni mal. Flap, a secas.</item>
    </string-array>
    <!-- Frase de Flap cansado (la semana va regular). -->
    <string-array name="passport_phrase_tired">
        <item>Flap tiene ojeras.</item>
        <item>Flap ha dormido poco y se le nota.</item>
        <item>Flap pide un respiro. Con un día tranquilo le vale.</item>
        <item>Flap bosteza entre vídeo y vídeo.</item>
        <item>Flap está cansado, pero no se rinde.</item>
    </string-array>
    <!-- Frase de Flap zombi (mucho scroll). Sin culpa: siempre se puede recuperar. -->
    <string-array name="passport_phrase_zombie">
        <item>Flap camina con los brazos por delante.</item>
        <item>Flap ya solo dice «uno más».</item>
        <item>Flap es un zombi del scroll. Se cura con un día tranquilo.</item>
        <item>Flap no muere. Solo pasa una mala racha.</item>
        <item>Flap se recupera en cuanto cumplas un día.</item>
    </string-array>
    <!-- Frase mientras Flap calienta (sin objetivo ni historial suficiente). -->
    <string-array name="passport_phrase_warming">
        <item>Flap aún te está conociendo. Dale unos días.</item>
        <item>Sin objetivo ni historial, Flap no juzga. Todavía.</item>
        <item>Flap está estirando. En unos días te dice algo.</item>
        <item>Primeros días: Flap observa y toma notas.</item>
    </string-array>
    <!-- Frase cuando Flap vuelve de zombi a normal o mejor. -->
    <string-array name="passport_phrase_recovered">
        <item>Flap ha vuelto de entre los scrolls.</item>
        <item>Ni zombi ni nada: Flap se ha recuperado.</item>
        <item>Flap vuelve a parpadear con normalidad.</item>
        <item>Flap ha vuelto. Dice que no se acuerda de nada.</item>
    </string-array>

