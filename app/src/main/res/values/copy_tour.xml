<?xml version="1.0" encoding="utf-8"?>
<!--
  Recorrido guiado de la primera vez (copy/TourCopy.kt): marcas sobre las pantallas reales con un
  título y una frase corta. Poco sitio: las frases tienen que caber con la letra al 130 % encima o
  debajo del elemento señalado. Siempre dice lo mismo (sin variantes).
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- Botones en MAYÚSCULAS, muy cortos. -->
    <string name="tour_skip">SALTAR</string>
    <string name="tour_done">LISTO</string>
    <!-- Contador en MAYÚSCULAS: «PASO 2 DE 6». %1$s el paso, %2$s el total. -->
    <string name="tour_step">PASO %1$s DE %2$s</string>

    <!-- TalkBack: título del panel y de los botones. -->
    <string name="tour_pane_title">Recorrido por Reelometer</string>
    <string name="tour_skip_description">Saltar el recorrido</string>
    <string name="tour_next_description">Paso siguiente del recorrido</string>
    <string name="tour_done_description">Terminar el recorrido</string>

    <!-- Título corto de cada paso (sin punto final). -->
    <!-- El marcador grande de Hoy con los vídeos del día. -->
    <string name="tour_counter_title">El marcador</string>
    <!-- La comparación con el día medio a la misma hora. -->
    <string name="tour_comparison_title">A esta hora</string>
    <!-- Las barras de Estadísticas. -->
    <string name="tour_stats_bars_title">Cada día, una barra</string>
    <!-- La pestaña del resumen (semana, mes, año). -->
    <string name="tour_wrapped_title">El resumen</string>
    <!-- La pestaña del pasaporte (Flap es la mascota: no se traduce). -->
    <string name="tour_passport_title">El pasaporte</string>
    <string name="tour_settings_title">Ajustes y calibración</string>

    <!-- Frase de cada paso. -->
    <string name="tour_counter_text">Tus vídeos de hoy. El marcador sube solo con cada uno y vuelve a cero a medianoche.</string>
    <string name="tour_comparison_text">Cómo vas frente a tu día medio a esta misma hora. Sin juicios, solo cifras.</string>
    <!-- Lo mismo cuando aún no hay comparación (faltan días): no señala nada. -->
    <string name="tour_comparison_text_empty">Con unos días contados, aquí verás cómo vas frente a tu día medio a esta misma hora.</string>
    <string name="tour_stats_bars_text">Mantén el dedo sobre una barra y desliza para ver la cifra exacta de cada día.</string>
    <string name="tour_wrapped_text">Tu semana, tu mes y tu año, contados como una historia. Con ticket para compartir, si te atreves.</string>
    <string name="tour_passport_text">Flap y tus sellos. Aquí la experiencia se gana viendo menos, nunca más.</string>
    <string name="tour_settings_text">Objetivo, avisos y tema, aquí arriba. Siete toques en la versión abren la calibración.</string>

    <!-- Lo que anuncia TalkBack al llegar a cada paso: «Paso 2 de 6. A esta hora. Cómo vas…».
         %1$s el paso, %2$s el total, %3$s el título del paso (sin punto), %4$s su frase (con punto). -->
    <string name="tour_announcement">Paso %1$s de %2$s. %3$s. %4$s</string>
</resources>
