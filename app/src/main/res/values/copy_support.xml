<?xml version="1.0" encoding="utf-8"?>
<!--
  Aviso de apoyo (copy/SupportCopy.kt): un único aviso grande y centrado que sale como mucho dos
  veces y lleva al GitHub del proyecto. Sin prometer nada que la app no haga: no tiene internet; el
  enlace lo abre el navegador. «GitHub» no se traduce.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- Antetítulo en MAYÚSCULAS, muy corto. -->
    <string name="support_kicker">UNA COSA</string>
    <string name="support_title">Esta app la hace un estudiante.</string>
    <string name="support_text">Reelómetro es gratis, no tiene anuncios y tus datos no salen del móvil. La hace un estudiante en sus ratos libres. En su GitHub puedes ver cómo está hecha y, si te apetece, apoyarlo.</string>
    <!-- Pie pequeño bajo el texto: qué pasa al pulsar. -->
    <string name="support_note">Se abre en el navegador. La app sigue sin internet.</string>
    <!-- Botón principal en MAYÚSCULAS. -->
    <string name="support_open">VER SU GITHUB</string>
    <!-- Enlace pequeño para no volver a ver el aviso. -->
    <string name="support_never">No volver a mostrar</string>
    <!-- Si no se pudo abrir el navegador. %1$s la dirección del proyecto sin «https://github.com/» («usuario/proyecto»). -->
    <string name="support_open_failed">No se ha podido abrir el navegador. Búscalo en GitHub: %1$s.</string>

    <!-- TalkBack: título del aviso y de los botones. -->
    <string name="support_pane_title">Apoyar Reelómetro</string>
    <string name="support_open_description">Ver su GitHub. Se abre en el navegador</string>
    <string name="support_never_description">No volver a mostrar este aviso</string>
</resources>
