<?xml version="1.0" encoding="utf-8"?>
<!--
  Detalle de un día (copy/DayCopy.kt): se abre al tocar el marcador o una barra del calendario.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). Los arrays con sufijo (_one, _notime, _noeq) son la
  misma situación en otro caso gramatical: mantén el mismo sentido en cada posición.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- Título en frase. %1$s es la fecha larga («martes 3 de noviembre»). -->
    <string name="day_title_today">Hoy, %1$s</string>
    <string name="day_title_yesterday">Ayer, %1$s</string>

    <!-- Etiqueta en MAYÚSCULAS (se pasa a mayúsculas sola): «MARTES 3 NOV». %1$s día de la semana,
         %2$s fecha corta («3 nov» o «3 nov 2025»). -->
    <string name="day_label_date">%1$s %2$s</string>
    <!-- «HOY · MARTES 3 NOV»: %1$s es la etiqueta de arriba, ya en mayúsculas. -->
    <string name="day_label_today">HOY · %1$s</string>
    <string name="day_label_yesterday">AYER · %1$s</string>

    <!-- Frase de un día pasado, cero vídeos. -->
    <string-array name="day_zero">
        <item>Ese día, ni un vídeo.</item>
        <item>Cero. Un día de los buenos, o uno sin cobertura.</item>
        <item>Nada ese día. O no viste nada, o yo no estaba mirando.</item>
    </string-array>

    <!-- Con objetivo, pasado: %1$s lo que se pasó («62 vídeos»), %2$s el objetivo, %3$s los vídeos del día. -->
    <string-array name="day_goal_over">
        <item>Ese día te pasaste en %1$s.</item>
        <item>Objetivo: %2$s. Ese día: %3$s.</item>
        <item>%1$s por encima del objetivo. Pasa.</item>
    </string-array>
    <!-- Con objetivo, justo en el límite: %1$s el objetivo. -->
    <string-array name="day_goal_at">
        <item>Justo en el límite: %1$s, ni uno más.</item>
        <item>%1$s de %1$s. Clavado.</item>
        <item>Objetivo clavado ese día.</item>
    </string-array>
    <!-- Con objetivo, por debajo: %1$s los vídeos del día, %2$s el objetivo, %3$s el margen («38 vídeos»). -->
    <string-array name="day_goal_under">
        <item>Dentro del objetivo: %1$s de %2$s.</item>
        <item>Por debajo de %2$s, con %3$s de margen.</item>
        <item>%1$s de %2$s. Día dentro del límite.</item>
    </string-array>

    <!-- Día flojo (1–9 vídeos): %1$s los vídeos («3 vídeos»), %2$s el tiempo («2 minutos»).
         _one: un solo vídeo. _notime: menos de un minuto (sin tiempo en la frase). -->
    <string-array name="day_first">
        <item>Ese día fueron %1$s. Casi nada.</item>
        <item>%1$s y %2$s. Un día tranquilo.</item>
        <item>Poca cosa: %1$s.</item>
    </string-array>
    <string-array name="day_first_notime">
        <item>Ese día fueron %1$s. Casi nada.</item>
        <item>%1$s. Un día tranquilo.</item>
        <item>Poca cosa: %1$s.</item>
    </string-array>
    <string-array name="day_first_one">
        <item>Ese día fue %1$s. Casi nada.</item>
        <item>%1$s y %2$s. Un día tranquilo.</item>
        <item>Poca cosa: %1$s.</item>
    </string-array>
    <string-array name="day_first_one_notime">
        <item>Ese día fue %1$s. Casi nada.</item>
        <item>%1$s. Un día tranquilo.</item>
        <item>Poca cosa: %1$s.</item>
    </string-array>

    <!-- Día normal: %1$s los vídeos, %2$s el tiempo («47 minutos»), %3$s el tiempo con mayúscula
         inicial (para empezar la frase con él). -->
    <string-array name="day_normal">
        <item>%1$s y %2$s. Un día normal, que ya es decir.</item>
        <item>Ese día: %2$s de vídeos.</item>
        <item>%3$s. Ni fu ni fa.</item>
    </string-array>

    <!-- Día alto: %1$s los vídeos, %2$s el tiempo con mayúscula inicial, %3$s el tiempo, %4$s una
         equivalencia en infinitivo («leer 14 libros»). _noeq: sin equivalencia (no uses %4$s).
         _one: el tiempo es singular («una hora y 40 minutos»). -->
    <string-array name="day_high">
        <item>%1$s. Ese día el algoritmo hizo horas extra.</item>
        <item>%2$s de vídeos. Te daba para %4$s.</item>
        <item>Ese día se te fueron %3$s. Así, sin más.</item>
    </string-array>
    <string-array name="day_high_noeq">
        <item>%1$s. Ese día el algoritmo hizo horas extra.</item>
        <item>%2$s de vídeos. Un día largo.</item>
        <item>Ese día se te fueron %3$s. Así, sin más.</item>
    </string-array>
    <string-array name="day_high_one">
        <item>%1$s. Ese día el algoritmo hizo horas extra.</item>
        <item>%2$s de vídeos. Te daba para %4$s.</item>
        <item>Ese día se te fue %3$s. Así, sin más.</item>
    </string-array>
    <string-array name="day_high_one_noeq">
        <item>%1$s. Ese día el algoritmo hizo horas extra.</item>
        <item>%2$s de vídeos. Un día largo.</item>
        <item>Ese día se te fue %3$s. Así, sin más.</item>
    </string-array>

    <!-- Día extremo: %1$s los vídeos, %2$s el tiempo con mayúscula inicial. -->
    <string-array name="day_extreme">
        <item>%1$s. Hay días y días, y este fue de los segundos.</item>
        <item>%2$s. Si alguien pregunta, tenías cosas que hacer.</item>
        <item>%1$s en un solo día. Ese día ganó el algoritmo.</item>
    </string-array>

    <!-- Puesto del día entre todos los contados (MAYÚSCULAS). -->
    <string name="day_rank_record">TU RÉCORD: EL DÍA CON MÁS VÍDEOS</string>
    <!-- %1$s el puesto, %2$s los días contados (siempre 2 o más). -->
    <plurals name="day_rank_line">
        <item quantity="one">N.º %1$s DE %2$s DÍA CONTADO</item>
        <item quantity="many">N.º %1$s DE %2$s DÍAS CONTADOS</item>
        <item quantity="other">N.º %1$s DE %2$s DÍAS CONTADOS</item>
    </plurals>

    <!-- Estado frente al objetivo de un día cerrado (MAYÚSCULAS, columna estrecha: corto). %1$s cifra. -->
    <string name="day_goal_status_over">+%1$s\u00A0PASADO</string>
    <string name="day_goal_status_at">EN EL LÍMITE</string>
    <string name="day_goal_status_under">%1$s\u00A0POR DEBAJO</string>

    <!-- Lo mismo para TalkBack: %1$s la diferencia («38 vídeos»), %2$s el objetivo. -->
    <string name="day_goal_status_over_description">%1$s por encima del objetivo de %2$s</string>
    <!-- %1$s el objetivo. -->
    <string name="day_goal_status_at_description">Justo en el objetivo de %1$s</string>
    <string name="day_goal_status_under_description">%1$s por debajo del objetivo de %2$s</string>

    <!-- Cabecera de la sección por horas de un día pasado (MAYÚSCULAS). -->
    <string name="day_section_hours">ESE DÍA, HORA A HORA</string>
    <!-- «PRIMER VÍDEO 08:12 · ÚLTIMO 01:47»: %1$s hora del primero, %2$s del último. -->
    <string name="day_first_last">PRIMER VÍDEO %1$s · ÚLTIMO %2$s</string>
</resources>
