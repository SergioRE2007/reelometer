    <string name="calibration_exit_cat_ignored">cierre normal</string>

    <!-- Memoria del proceso al morir, detrás de la línea del cierre: %1$s = la línea, %2$s = PSS en MB, %3$s = RSS en MB (RSS no se traduce). -->
    <string name="calibration_exit_memory">%1$s · memoria %2$s\u00A0MB (RSS %3$s\u00A0MB)</string>

    <!-- Cabecera del registro: estado del sistema. Lo que Android dice de la app y lo que el servicio apunta de su vida, para saber por qué deja de contar tras un rato sin usar el móvil. Formato «clave: valor». En conexiones y desconexiones, %1$s es la fecha y la hora. «standby bucket» es el nombre de Android. -->
    <string name="calibration_system_title">Estado del sistema (lo que Android dice de la app):</string>
    <string name="calibration_system_battery">Batería sin restricciones: %1$s · uso en segundo plano restringido: %2$s · ahorro de batería encendido: %3$s</string>
    <string name="calibration_system_bucket">Grupo de uso (standby bucket): %1$s</string>
    <string name="calibration_system_hibernation">Exenta de «Pausar actividad de la app si no se usa»: %1$s</string>
    <string name="calibration_system_process">Proceso arrancado hace %1$s · avisos permitidos: %2$s</string>
    <string name="calibration_system_connections">Conexiones del servicio (la más reciente primero): %1$s</string>
