<?xml version="1.0" encoding="utf-8"?>
<!--
  Rendimiento del servicio en la pantalla oculta de Calibración y en el registro que se comparte (lo leen testers y
  desarrollo; copy/CalibrationMetricsCopy.kt). Formato de consola, «clave valor», sin plurales. Las cifras llegan ya
  formateadas. «onAccessibilityEvent» no se traduce. El interruptor CAPTURAR se cita con el mismo texto que
  state_calibration_capture (copy_state.xml).
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <string name="calibration_metrics_key">RENDIMIENTO</string>
    <string name="calibration_metrics_summary">%1$s ev/min · %2$s\u00A0ms de media (máx. %3$s) · %4$s nodos por lectura</string>
    <string name="calibration_metrics_title">Rendimiento del servicio: últimos %1$s, %2$s con actividad (los ritmos por minuto van sobre ese rato) · conexiones del servicio: %3$s</string>
    <string name="calibration_metrics_events">%1$s · eventos %2$s (%3$s/min) · desplazamiento %4$s · ventana %5$s · clic %6$s · contenido %7$s</string>
    <string name="calibration_metrics_content">Cambios de contenido fuera de un envío rápido: %1$s (deberían ser 0; los de cada app, arriba)</string>
    <string name="calibration_metrics_handler">onAccessibilityEvent: eventos %1$s · media %2$s\u00A0ms · máx. %3$s\u00A0ms · más de 16\u00A0ms: %4$s</string>
    <string name="calibration_metrics_lag">Retraso de entrega de los eventos: máx. %1$s\u00A0ms · de 2\u00A0s o más: %2$s (si hay alguno, el proceso estuvo congelado o sin CPU)</string>
    <string name="calibration_metrics_reads">Lecturas de pantalla en %1$s: %2$s (sin nada: %3$s) · nodos de media %4$s, máx. %5$s · media %6$s\u00A0ms, máx. %7$s\u00A0ms</string>
    <string name="calibration_metrics_ipc">Pedidos al sistema: hijos %1$s · padres %2$s · búsquedas %3$s</string>
    <string name="calibration_metrics_presence">Comprobaciones de presencia (hilo principal): %1$s · media %2$s\u00A0ms · máx. %3$s\u00A0ms</string>
    <string name="calibration_metrics_unreadable">Lecturas de pantalla sin nada legible (otra ventana encima, sin raíz u otra app): %1$s</string>
    <string name="calibration_metrics_quick">Envío rápido: pasos %1$s · media %2$s\u00A0ms · máx. %3$s\u00A0ms · hijos pedidos %4$s</string>
    <string name="calibration_metrics_capturing">%1$s de los eventos llegaron con CAPTURAR encendido: sus tiempos incluyen el propio registro.</string>
    <string name="calibration_metrics_none">Sin datos del servicio desde que arrancó.</string>
    <string name="calibration_metrics_rate_unknown">—</string>
    <string name="calibration_redacted">[contacto %1$s]</string>

    <!-- Cabecera del registro: últimos cierres de la app. Línea: fecha y hora · categoría · enlazado o no · motivo/submotivo (números de Android) · descripción del sistema. Sin líneas, una sola frase: no hay ninguno (none), esta versión de Android no los guarda (unavailable, antes de Android 11) o no se han podido leer (failed). other_app sustituye en la descripción el nombre de paquete de otra app. -->
    <string name="calibration_exits_key">CIERRES</string>
    <string name="calibration_exits_title">Últimos cierres de la app (los guarda Android, el más reciente primero):</string>
    <string name="calibration_exits_none">Android no guarda ningún cierre de la app.</string>
    <string name="calibration_exits_unavailable">Esta versión de Android no guarda los cierres de la app: hace falta Android 11 o posterior.</string>
    <string name="calibration_exits_failed">No se han podido leer los cierres de la app que guarda Android.</string>
    <string name="calibration_exit_line">%1$s · %2$s · %3$s · motivo %4$s/%5$s · %6$s</string>
    <string name="calibration_exit_when">%1$s %2$s</string>
    <string name="calibration_exit_bound">enlazado</string>
    <string name="calibration_exit_unbound">sin enlazar</string>
    <string name="calibration_exit_no_description">sin descripción</string>
    <string name="calibration_exit_other_app">[otra app %1$s]</string>
    <string name="calibration_exit_cat_recents">limpiar recientes</string>
    <string name="calibration_exit_cat_low_memory">falta de memoria</string>
    <string name="calibration_exit_cat_system">sistema</string>
