    <string name="label_shares">SHARED</string>
    <string name="label_daily_average">DAILY AVG</string>
    <string name="label_active_days">ACTIVE DAYS</string>
    <string name="label_first_video">FIRST VIDEO</string>
    <string name="label_last_video">LAST VIDEO</string>
