    <string name="label_platforms">PLATFORMS</string>
    <string name="label_categories">CATEGORIES</string>
    <!-- Cuentas que publican los vídeos. -->
    <string name="label_creators">CREATORS</string>
    <string name="label_top_creator">TOP CREATOR</string>
    <string name="label_top_category">TOP CATEGORY</string>
