<?xml version="1.0" encoding="utf-8"?>
<!--
  Etiquetas, botones y descripciones para TalkBack que se usan en toda la app (copy/Labels.kt).
  label_* y button_* van en MAYÚSCULAS y con muy poco sitio (etiquetas pequeñas con tracking,
  botones, pestañas): escríbelas ya en mayúsculas y lo más cortas posible.
  a11y_* son descripciones habladas (TalkBack): frase normal, sin punto final.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- Etiquetas cortas en MAYÚSCULAS sobre cifras (marcador, estadísticas, resumen, ticket). Poco sitio. -->
    <string name="label_videos">VIDEOS</string>
    <string name="label_video">VIDEO</string>
    <string name="label_time">TIME</string>
    <string name="label_today">TODAY</string>
    <string name="label_yesterday">YESTERDAY</string>
    <string name="label_goal">GOAL</string>
    <!-- El servicio de accesibilidad está desconectado (el marcador se queda en blanco). -->
    <string name="label_no_signal">NO SIGNAL</string>
    <!-- La hora del día con más vídeos. -->
    <string name="label_peak_hour">PEAK HOUR</string>
    <string name="label_weak_day">WEAK DAY</string>
    <string name="label_worst_day">WORST DAY</string>
    <!-- Racha: días seguidos cumpliendo el objetivo. -->
    <string name="label_streak">STREAK</string>
    <string name="label_current_streak">CURRENT STREAK</string>
    <string name="label_best_streak">BEST STREAK</string>
    <!-- Tiempo medio que dura cada vídeo. -->
    <string name="label_per_video">PER VIDEO</string>
