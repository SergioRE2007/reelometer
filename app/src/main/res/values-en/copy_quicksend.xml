<?xml version="1.0" encoding="utf-8"?>
<!--
  Envío rápido (copy/QuickSendCopy.kt): burbujas que pone la app sobre los vídeos de Instagram y TikTok
  para compartirlos con un toque. Las burbujas no llevan texto visible: casi todo es para TalkBack,
  más la pregunta de si apagarlo. %1$s es siempre el nombre de una persona o un grupo de esa app.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- TalkBack de cada burbuja, según su estado. -->
    <string name="quicksend_bubble_description">Send this video to %1$s</string>
    <string name="quicksend_sending_description">Sending to %1$s</string>
    <string name="quicksend_sent_description">Sent to %1$s</string>
    <!-- No ha encontrado algo: si la hoja de compartir se abrió, se queda abierta para terminar a mano. -->
    <string name="quicksend_failed_description">I couldn\'t send it to %1$s</string>
    <!-- Acción de TalkBack: enviar a dos a la vez. %1$s esta burbuja, %2$s otra persona o grupo fijado. -->
    <string name="quicksend_pair_action">Send to %1$s and %2$s</string>
    <!-- Acción de TalkBack en cada burbuja (equivale a soltarla en la «X»). -->
    <string name="quicksend_hide_action">Hide until the next video</string>
    <!-- Nombre de la ventana de las burbujas (TalkBack la anuncia así). -->
    <string name="quicksend_window_title">Reelometer quick send</string>
    <!-- La zona «X» que sale abajo mientras arrastras las burbujas. -->
    <string name="quicksend_zone_title">Drop here to hide</string>

    <!-- Pregunta tras esconder las burbujas tres veces seguidas (sale una sola vez).
         «A quién envías» es el nombre del ajuste de la app (settings_recipients_label). -->
    <string name="quicksend_ask_title">Turn off quick send?</string>
    <string name="quicksend_ask_body">You\'ve hidden the bubbles three times in a row. If you turn it off, you can turn it back on in Settings, under “Who you send to”.</string>
    <!-- Botones en MAYÚSCULAS, muy cortos. -->
    <string name="quicksend_ask_turn_off">TURN OFF</string>
    <string name="quicksend_ask_keep">KEEP IT</string>
</resources>
