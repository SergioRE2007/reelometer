    <!-- Encima de la lista de personas y grupos para fijar. %1$s el nombre de la app. -->
    <string name="settings_quick_send_list_label_app">Who you send to most on %1$s</string>
    <!-- Bajo RECOLOCAR y tras pulsarlo. %1$s el nombre de la app. -->
    <string name="settings_quick_send_relocate_hint_app">Your %1$s bubbles go back to their spot on the right edge.</string>
    <string name="settings_quick_send_relocated_app">Done. You\'ll see them in place on the next %1$s video.</string>

