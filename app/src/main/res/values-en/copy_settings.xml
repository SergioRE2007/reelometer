    <string name="settings_index_notifications">Alerts</string>
    <string name="settings_index_apps">Apps</string>
    <string name="settings_index_theme">Theme</string>
    <string name="settings_index_data">Your data</string>
    <string name="settings_index_service">Service</string>
    <string name="settings_index_privacy">Privacy</string>
    <string name="settings_index_about">About</string>
