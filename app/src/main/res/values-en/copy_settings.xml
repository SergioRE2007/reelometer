<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de Ajustes (copy/SettingsCopy.kt): una lista editorial de 8 secciones numeradas
  («01  OBJETIVO ─────» + descripción). Habla la app en primera persona («te aviso», «cuento»).
  Los textos en MAYÚSCULAS se ven así en pantalla (etiquetas y botones): escríbelos en mayúsculas.
  Los botones y etiquetas tienen poco sitio: mejor cortos.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- Título de la pantalla (barra de arriba). -->
    <string name="settings_title">Settings</string>

    <!-- Secciones: título en MAYÚSCULAS (cabecera numerada, poco sitio) y descripción bajo él. -->
    <string name="settings_section_goal_title">GOAL</string>
    <string name="settings_section_goal_description">A daily maximum of videos. It powers the “left to go” on Today and the streaks.</string>
    <string name="settings_section_notifications_title">ALERTS</string>
    <string name="settings_section_notifications_description">One summary a day, at the time you pick, and another every month.</string>
    <string name="settings_section_apps_title">WHICH APPS I COUNT</string>
    <string name="settings_section_apps_description">Whatever you turn off here stops counting straight away. What\'s already counted stays.</string>
    <!-- Sección del tema (claro, oscuro o el del sistema); también lleva la fila del idioma. -->
    <string name="settings_section_theme_title">THEME</string>
    <string name="settings_section_theme_description">The counter looks better in the dark, but you\'re in charge.</string>
    <string name="settings_section_data_title">YOUR DATA</string>
    <string name="settings_section_data_description">Everything counted lives on this phone. You can take it with you, bring it back or delete it.</string>
    <string name="settings_section_service_title">SERVICE</string>
    <string name="settings_section_service_description">The accessibility permission is what lets me count. Here you can see whether it\'s on.</string>
    <string name="settings_section_privacy_title">PRIVACY</string>
    <string name="settings_section_privacy_description">What happens to your data, with no fine print.</string>
    <string name="settings_section_about_title">ABOUT</string>
    <string name="settings_section_about_description">Reelometer has nothing to do with TikTok, Instagram or YouTube. It only counts what you see on them.</string>

