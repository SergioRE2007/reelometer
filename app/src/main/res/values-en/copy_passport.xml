<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo Pasaporte (copy/PassportCopy.kt): pestaña con Flap (la mascota), la tarjeta de embarque
  (niveles y millas), los sellos, el reto semanal contra «tu fantasma» (tú la semana pasada), las
  celebraciones y el ticket de nivel que se comparte como imagen.
  Tono: aeropuerto, tarjeta de embarque, ironía amable. Premia ver menos y nunca culpa.
  Las millas salen de ver MENOS vídeos (días bajo la referencia, rachas, retos y sellos), nunca de verlos.
  Nombres propios: «Flap» (la mascota) y «Reelometer» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña y nombre del modo (palabra normal: tradúcela). -->
    <string name="passport_title">Passport</string>

    <!-- Cabeceras de sección, en MAYÚSCULAS. «FLAP» es el nombre de la mascota (no se traduce). -->
    <string name="passport_section_flap">FLAP</string>
    <string name="passport_section_level">BOARDING PASS</string>
    <string name="passport_section_challenge">WEEKLY CHALLENGE</string>
    <string name="passport_section_stamps">STAMPS</string>
    <string name="passport_section_past">PAST CHALLENGES</string>

    <!-- Kicker de la cabecera: «63 DÍAS A BORDO». %1$s son los días («63 días»). Se pasa a mayúsculas sola. -->
    <string name="passport_on_board">%1$s on board</string>

    <!-- ============================================================ Flap (la mascota) -->

    <!-- Estado de Flap, en MAYÚSCULAS y corto (etiqueta junto al dibujo). En TalkBack se lee en minúsculas. -->
    <string name="passport_mood_fit">IN SHAPE</string>
    <string name="passport_mood_normal">NORMAL</string>
    <string name="passport_mood_tired">TIRED</string>
    <string name="passport_mood_zombie">SCROLL ZOMBIE</string>
    <!-- Estado mientras Flap no tiene con qué comparar (ni objetivo ni historial). MAYÚSCULAS. -->
    <string name="passport_warming_up">WARMING UP</string>

    <!-- Frase de Flap en forma (la semana va bien). -->
    <string-array name="passport_phrase_fit">
        <item>Flap is coasting this week.</item>
        <item>Flap is in peak form. So are you, even if you don’t look it.</item>
        <item>Flap has forgotten what scrolling was like.</item>
        <item>Flap is back to looking out the window.</item>
        <item>Flap signed up for a run. So far, so good.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="passport_phrase_normal">
        <item>Flap is getting by.</item>
        <item>Flap, meh. Flap, so-so.</item>
        <item>Flap is holding the line.</item>
        <item>Flap is like your week: normal.</item>
        <item>Flap is neither good nor bad. Just Flap.</item>
    </string-array>
    <!-- Frase de Flap cansado (la semana va regular). -->
    <string-array name="passport_phrase_tired">
        <item>Flap has bags under the eyes.</item>
        <item>Flap hasn’t slept much, and it shows.</item>
        <item>Flap is asking for a break. A quiet day would do.</item>
        <item>Flap yawns between one video and the next.</item>
        <item>Flap is tired, but not giving up.</item>
    </string-array>
    <!-- Frase de Flap zombi (mucho scroll). Sin culpa: siempre se puede recuperar. -->
    <string-array name="passport_phrase_zombie">
        <item>Flap walks with its arms out in front.</item>
        <item>Flap only says “one more” now.</item>
        <item>Flap is a scroll zombie. A quiet day will cure it.</item>
        <item>Flap isn’t dead. It’s just having a rough patch.</item>
        <item>Flap recovers as soon as you have one good day.</item>
    </string-array>
    <!-- Frase mientras Flap calienta (sin objetivo ni historial suficiente). -->
    <string-array name="passport_phrase_warming">
        <item>Flap is still getting to know you. Give it a few days.</item>
        <item>No goal, no history: Flap isn’t judging. Yet.</item>
        <item>Flap is stretching. In a few days it’ll have something to say.</item>
        <item>First few days: Flap is watching and taking notes.</item>
    </string-array>
    <!-- Frase cuando Flap vuelve de zombi a normal o mejor. -->
    <string-array name="passport_phrase_recovered">
        <item>Flap is back from the living dead.</item>
        <item>Not a zombie anymore: Flap has recovered.</item>
        <item>Flap is blinking normally again.</item>
        <item>Flap is back. Says it doesn’t remember a thing.</item>
    </string-array>

    <!-- Registro de la semana bajo Flap, en MAYÚSCULAS (sin días contados esta semana). -->
    <string name="passport_record_none">NO RECORD THIS WEEK</string>
    <!-- «5 DE 7 DÍAS BAJO TU OBJETIVO»: %1$s días bajo el objetivo, %2$s días contados (la forma va
         según %2$s). Se pasa a mayúsculas sola. -->
