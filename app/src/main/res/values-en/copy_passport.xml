        <item quantity="one">%1$s of %2$s\u00A0day under your goal</item>
        <item quantity="other">%1$s of %2$s\u00A0days under your goal</item>
    </plurals>
    <!-- Igual sin objetivo: la referencia es la media del usuario. -->
    <plurals name="passport_record_average">
        <item quantity="one">%1$s of %2$s\u00A0day under your average</item>
        <item quantity="other">%1$s of %2$s\u00A0days under your average</item>
    </plurals>
    <!-- «TU OBJETIVO: 150 AL DÍA» / «TU MEDIA: 140 AL DÍA». %1$s vídeos al día. Se pasa a mayúsculas sola. -->
    <string name="passport_reference_goal">your goal: %1$s a day</string>
    <string name="passport_reference_average">your average: %1$s a day</string>

    <!-- TalkBack: Flap entero. %1$s el estado en minúsculas («cansado»), %2$s el registro como frase
         («5 de 7 días bajo tu objetivo.»), %3$s la frase de Flap. -->
    <string name="passport_flap_description">Flap, your passport mascot: %1$s. %2$s %3$s</string>
    <!-- TalkBack: Flap mientras calienta. %1$s la frase de Flap. -->
    <string name="passport_flap_description_warming">Flap, your passport mascot: warming up. %1$s</string>
    <!-- TalkBack, acción al tocar a Flap: «toca dos veces para saludar a Flap». Empieza en minúscula. -->
    <string name="passport_flap_tap">say hi to Flap</string>

