<?xml version="1.0" encoding="utf-8"?>
<!--
  Pestaña Flap (copy/FlapCopy.kt): Flap, la mascota, empieza cada día a tope (100 de vida) y cada
  vídeo que ves le quita un poco. Con el objetivo diario llega a la noche a media vida y, con el
  doble, cae KO hasta mañana. A medianoche revive.
  Estados, del mejor al peor: EN FORMA, NORMAL, CANSADO, ENFERMO y KO.
  Tono: humor seco y cariñoso; Flap se pone malo, pero nadie tiene la culpa ni hay sermones.
  Nombres propios: «Flap» (la mascota) y «Reelometer» (la app) no se traducen.
  Cada <string-array> es una situación y cada <item>, una frase alternativa (se elige una por día).
  Puedes poner las que quieras (mínimo 2). \u00A0 es un espacio duro: la cifra y su palabra no se separan.
  «Se pasa a mayúsculas sola» quiere decir que el código la convierte en MAYÚSCULAS: escríbela normal.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- ============================================================ cabecera -->

    <!-- Titular de la pestaña: el nombre de la mascota (no se traduce). -->
    <string name="flap_title">Flap</string>
    <!-- Kicker de la cabecera: «HOY · MARTES 3 NOV». %1$s el día de la semana, %2$s la fecha corta.
         Se pasa a mayúsculas sola. -->
    <string name="flap_kicker">Today · %1$s %2$s</string>

    <!-- ============================================================ estado de Flap -->

    <!-- Etiqueta encima del nombre del estado, en MAYÚSCULAS: «HOY FLAP ESTÁ / ENFERMO». -->
    <string name="flap_state_label">TODAY FLAP IS</string>

    <!-- Nombre del estado, en MAYÚSCULAS y corto (va en grande tras «HOY FLAP ESTÁ», en la pestaña Flap). -->
    <string name="flap_mood_fit">FIGHTING FIT</string>
    <string name="flap_mood_normal">FINE</string>
    <string name="flap_mood_tired">TIRED</string>
    <string name="flap_mood_sick">SICK</string>
    <string name="flap_mood_ko">KO</string>

    <!-- El estado dentro de una frase hablada (TalkBack y la descripción del widget): en minúsculas y sin siglas («fuera de combate», no «KO»). -->
    <string name="flap_mood_spoken_fit">fighting fit</string>
    <string name="flap_mood_spoken_normal">fine</string>
    <string name="flap_mood_spoken_tired">tired</string>
    <string name="flap_mood_spoken_sick">sick</string>
    <string name="flap_mood_spoken_ko">knocked out</string>

    <!-- Frase de Flap en forma (ha visto pocos vídeos hoy). -->
    <string-array name="flap_phrase_fit">
        <item>Flap is at full blast. And knows it.</item>
        <item>Flap is buzzing. Bring it on.</item>
        <item>Flap looks fresh out of the box.</item>
        <item>Flap has more energy than your battery first thing in the morning.</item>
        <item>Flap bounces around like nothing can touch it.</item>
    </string-array>
    <!-- Frase de Flap normal. -->
    <string-array name="flap_phrase_normal">
        <item>Flap is getting by.</item>
        <item>Flap is fine. Nothing to write home about.</item>
        <item>Flap is holding up.</item>
        <item>Flap is still standing. No fuss.</item>
        <item>Flap is okay. Which is something.</item>
    </string-array>
    <!-- Frase de Flap cansado (cerca de su aguante). -->
    <string-array name="flap_phrase_tired">
        <item>Flap has bags under its eyes.</item>
        <item>Flap yawns between videos.</item>
        <item>Flap could use a break. A short one will do.</item>
        <item>Flap is running on fumes.</item>
        <item>Flap has stopped bouncing. It just walks now.</item>
    </string-array>
    <!-- Frase de Flap enfermo (ha pasado su aguante). Sin culpa: mañana se le pasa. -->
    <string-array name="flap_phrase_sick">
        <item>Flap has scroll fever.</item>
        <item>Flap took its temperature. It didn’t like the number.</item>
        <item>Flap is shivering. Every video goes down worse.</item>
        <item>Flap is under the weather. It’ll pass by tomorrow.</item>
        <item>Flap wants soup and a blanket.</item>
    </string-array>
    <!-- Frase de Flap KO (el doble de su aguante). Sin dramas. Debajo de la barra ya pone «KO hasta mañana. A medianoche revive.»:
         que la frase no repita cuándo revive ni vuelva a decir «KO». -->
    <string-array name="flap_phrase_ko">
        <item>Flap is down for the count.</item>
        <item>Flap is flat on the mat. Not even soup would help.</item>
        <item>Flap has collapsed. Not even a blink.</item>
        <item>Flap can’t take any more. It’s staying on the floor.</item>
    </string-array>
    <!-- Frase de Flap recién llegado (la app aún no ha contado ningún vídeo). -->
    <string-array name="flap_phrase_fresh">
        <item>Flap just arrived and is at full blast.</item>
        <item>Flap starts out with its whole life ahead of it.</item>
        <item>Flap is brand new. It hasn’t seen a single video yet.</item>
        <item>Flap is waiting for you, fighting fit. Let’s see how long that lasts.</item>
    </string-array>
    <!-- Frase cuando Flap ha mejorado desde la última vez que lo viste: por un día nuevo o por un objetivo más alto (también
         a media tarde). Que no hable del día, de ayer ni de que estaba caído. Sale con cualquier mejora, también de KO a
         ENFERMO o de ENFERMO a CANSADO (al subir el objetivo o en un día nuevo con muchos vídeos ya vistos): que no dé por
         hecho que ya está bien. -->
    <string-array name="flap_phrase_recovered">
        <item>Flap is perking up.</item>
        <item>Flap is better than the last time you saw it.</item>
        <item>Flap is breathing a little easier than before.</item>
        <item>Flap is back and says it feels better.</item>
    </string-array>

    <!-- TalkBack: Flap. %1$s el estado en minúsculas («enfermo»), %2$s la vida («32») y %3$s el máximo («100»).
         La frase de Flap se lee aparte. -->
    <string name="flap_description">Flap: %1$s, health %2$s of %3$s.</string>
    <!-- Acción de tocar a Flap (TalkBack: «toca dos veces para saludar a Flap»). -->
    <string name="flap_tap">say hi to Flap</string>

    <!-- ============================================================ vida -->

    <!-- Etiqueta de la barra de vida, en MAYÚSCULAS. -->
    <string name="flap_life">HEALTH</string>
    <!-- TalkBack de la barra de vida: «Vida: 62 de 100». -->
    <string name="flap_life_description">Health: %1$s of %2$s</string>
    <!-- «HOY 31 VÍDEOS · AGUANTA 40»: %1$s los vídeos de hoy (la forma va según ellos), %2$s su aguante
         (el objetivo o, sin objetivo, 150). Se pasa a mayúsculas sola. -->
    <plurals name="flap_today_line">
        <item quantity="one">Today %1$s\u00A0video · can take %2$s</item>
        <item quantity="other">Today %1$s\u00A0videos · can take %2$s</item>
    </plurals>
    <!-- Lo que falta para el siguiente estado, peor. %1$s los vídeos que faltan (la forma va según ellos). -->
    <plurals name="flap_next_normal">
        <item quantity="one">%1$s\u00A0more video and it stops being fighting fit.</item>
        <item quantity="other">%1$s\u00A0more videos and it stops being fighting fit.</item>
    </plurals>
    <plurals name="flap_next_tired">
        <item quantity="one">%1$s\u00A0more video and it gets tired.</item>
        <item quantity="other">%1$s\u00A0more videos and it gets tired.</item>
    </plurals>
    <plurals name="flap_next_sick">
        <item quantity="one">%1$s\u00A0more video and it gets sick.</item>
        <item quantity="other">%1$s\u00A0more videos and it gets sick.</item>
    </plurals>
    <plurals name="flap_next_ko">
        <item quantity="one">%1$s\u00A0more video and it’s knocked out.</item>
        <item quantity="other">%1$s\u00A0more videos and it’s knocked out.</item>
    </plurals>
    <!-- Ya está KO: no hay nada peor. -->
    <string name="flap_ko_until_tomorrow">KO until tomorrow. It comes back at midnight.</string>

    <!-- ============================================================ cómo funciona -->

    <!-- Cabecera de sección, en MAYÚSCULAS. -->
    <string name="flap_section_how">HOW IT WORKS</string>
    <!-- %1$s la vida máxima («100»). -->
    <string name="flap_how_start">Every day Flap starts at full health (%1$s). At midnight it comes back.</string>
    <string name="flap_how_video">Every video you watch takes a little health away.</string>
    <!-- Con objetivo: %1$s el objetivo (la forma va según él), %2$s el doble. -->
    <plurals name="flap_how_goal">
        <item quantity="one">At your goal (%1$s\u00A0video) it ends the day at half health; at double (%2$s), it’s KO.</item>
        <item quantity="other">At your goal (%1$s\u00A0videos) it ends the day at half health; at double (%2$s), it’s KO.</item>
    </plurals>
    <!-- Sin objetivo: %1$s el aguante (150; la forma va según él), %2$s el doble. -->
    <plurals name="flap_how_default">
        <item quantity="one">At %1$s\u00A0video it ends the day at half health; at double (%2$s), it’s KO.</item>
        <item quantity="other">At %1$s\u00A0videos it ends the day at half health; at double (%2$s), it’s KO.</item>
    </plurals>
    <!-- Sin objetivo, junto al botón PONER OBJETIVO. %1$s el aguante (150; la forma va según él). -->
    <plurals name="flap_no_goal">
        <item quantity="one">Without a goal, Flap can take %1$s\u00A0video a day. With yours, it lasts as long as you decide.</item>
        <item quantity="other">Without a goal, Flap can take %1$s\u00A0videos a day. With yours, it lasts as long as you decide.</item>
    </plurals>
    <!-- TalkBack del botón PONER OBJETIVO. -->
    <string name="flap_set_goal_description">Set a daily goal in Settings</string>

    <!-- ============================================================ la semana -->

    <!-- Cabecera de sección, en MAYÚSCULAS. -->
    <string name="flap_section_week">THE WEEK</string>
    <!-- TalkBack de un día: «Martes 3 de noviembre: 34 vídeos, cansado.». %1$s el día, %2$s los vídeos
         («34 vídeos»), %3$s el estado en minúsculas. -->
    <string name="flap_day_description">%1$s: %2$s, %3$s.</string>
    <!-- TalkBack de un día anterior a los primeros vídeos contados. %1$s el día. -->
    <string name="flap_day_description_none">%1$s: no record.</string>
    <!-- Etiqueta de la racha, en MAYÚSCULAS. -->
    <string name="flap_streak_label">STREAK</string>
    <!-- Días cerrados seguidos sin pasar del aguante. %1$s los días (la forma va según ellos). -->
    <plurals name="flap_streak">
        <item quantity="one">%1$s\u00A0day in a row without getting sick</item>
        <item quantity="other">%1$s\u00A0days in a row without getting sick</item>
    </plurals>
</resources>
