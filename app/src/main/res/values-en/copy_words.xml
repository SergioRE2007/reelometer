<?xml version="1.0" encoding="utf-8"?>
<!--
  Palabras compartidas por toda la app (copy/Words.kt): recuentos con plural, duraciones con
  palabras, listas, horas y periodos. %1$s es siempre la cifra ya formateada («1.234»).
  \u00A0 es un espacio duro: la cifra y su palabra no se separan al partir la línea.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- Recuentos: «1 vídeo», «212 vídeos». -->
    <plurals name="words_videos">
        <item quantity="one">%1$s\u00A0video</item>
        <item quantity="other">%1$s\u00A0videos</item>
    </plurals>
    <plurals name="words_times">
        <item quantity="one">%1$s\u00A0time</item>
        <item quantity="other">%1$s\u00A0times</item>
    </plurals>
    <plurals name="words_days">
        <item quantity="one">%1$s\u00A0day</item>
        <item quantity="other">%1$s\u00A0days</item>
    </plurals>
    <plurals name="words_hours">
        <item quantity="one">%1$s\u00A0hour</item>
        <item quantity="other">%1$s\u00A0hours</item>
    </plurals>
    <plurals name="words_minutes">
        <item quantity="one">%1$s\u00A0minute</item>
        <item quantity="other">%1$s\u00A0minutes</item>
    </plurals>
    <plurals name="words_seconds">
        <item quantity="one">%1$s\u00A0second</item>
        <item quantity="other">%1$s\u00A0seconds</item>
    </plurals>

    <!-- Duraciones dentro de una frase: «un segundo», «45 segundos», «un minuto», «47 minutos»,
         «una hora», «3 horas». En español el 1 va en letra; en idiomas donde «one» abarca más
         números (ruso: 21, 31…), escribe la cifra con %1$s. -->
    <plurals name="words_duration_seconds">
        <item quantity="one">a second</item>
        <item quantity="other">%1$s\u00A0seconds</item>
    </plurals>
    <plurals name="words_duration_minutes">
        <item quantity="one">a minute</item>
        <item quantity="other">%1$s\u00A0minutes</item>
    </plurals>
    <plurals name="words_duration_hours">
        <item quantity="one">an hour</item>
        <item quantity="other">%1$s\u00A0hours</item>
    </plurals>
    <!-- «una hora y 12 minutos»: %1$s las horas, %2$s los minutos (ya con sus palabras). -->
    <string name="words_duration_hours_minutes">%1$s and %2$s</string>

    <!-- Listas: «TikTok, Reels y Shorts». Separador entre los primeros (con su espacio). -->
    <string name="words_list_separator">", "</string>
    <!-- %1$s los primeros ya unidos, %2$s el último. -->
    <string name="words_list_last">%1$s and %2$s</string>
    <!-- Igual, cuando el último empieza por el sonido /i/ («Reels e Instagram»). Si tu idioma no
         cambia nada, copia la de arriba. -->
    <string name="words_list_last_i">%1$s and %2$s</string>

    <!-- Hora dentro de una frase: «a las 23:00»; %1$s es la hora («23:00»). -->
    <string name="words_at_time">at %1$s</string>
    <!-- Igual, para la una («a la 01:00»). Si tu idioma no cambia nada, copia la de arriba. -->
    <string name="words_at_time_one">at %1$s</string>

    <!-- Periodos (copy/Words.kt, CopyPeriod). Para frases con concordancia hay frases enteras por
         periodo en cada pantalla; estas son las piezas sueltas que aún se usan. -->
    <string name="period_week_noun">week</string>
    <string name="period_week_this">this week</string>
    <string name="period_week_that">that week</string>
    <string name="period_week_previous">the previous week</string>
    <string name="period_month_noun">month</string>
    <string name="period_month_this">this month</string>
    <string name="period_month_that">that month</string>
    <string name="period_month_previous">the previous month</string>
    <string name="period_year_noun">year</string>
    <string name="period_year_this">this year</string>
    <string name="period_year_that">that year</string>
    <string name="period_year_previous">the previous year</string>
    <string name="period_all_noun">history</string>
    <string name="period_all_this">your history</string>
    <string name="period_all_that">your history</string>
</resources>
