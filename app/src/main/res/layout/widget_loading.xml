<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que enseña el launcher hasta que Glance pinta el widget por primera vez: la ficha vacía
     con «CONTANDO». RemoteViews no admite las fuentes de la app: monoespaciada del sistema. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="12dp"
    tools:targetApi="31">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>
